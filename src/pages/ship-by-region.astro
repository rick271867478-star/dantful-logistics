---
import BaseLayout from '../layouts/BaseLayout.astro';
import { regions } from '../data/regions';
---

<BaseLayout
  title="Shipping Routes from China Worldwide"
  description="Shipping routes from China to North America, Europe, Middle East, Africa, Australia, Southeast Asia and South America. Ocean and air freight with reliable transit times from major Chinese ports."
>
  <section class="hub-hero">
    <div class="hub-hero-bg">
      <img src="/images/ship-by-region-hero.webp" alt="Worldwide shipping routes from China - global freight network" loading="eager" />
    </div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Ship by Region</span>
      </nav>
      <h1 class="hub-hero-title">SHIP BY REGION</h1>
      <p class="hub-hero-sub">Explore our main shipping routes from China to 7 regions worldwide -- North America, Europe, Middle East, Africa, Australia & Oceania, Southeast Asia and South America. Direct ocean FCL, LCL consolidation and air freight services from Shanghai, Shenzhen, Ningbo, Guangzhou and Hong Kong to all major destination ports.</p>
      <div class="hub-hero-cta">
        <a href="/contact/" class="btn btn-primary">Get a Quote</a>
        <a href="/routes/" class="btn btn-outline">View All Routes</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="grid grid-3">
        {regions.map((r) => (
          <a href={`/ship-by-region/${r.slug}/`} class="card region-card">
            <div class="region-card-img">
              <img src={`/images/region-${r.slug}.webp`} alt={`Shipping to ${r.name} from China`} loading="lazy" />
            </div>
            <div class="region-card-body">
              <h3>{r.name}</h3>
              <p>{r.intro}</p>
              <span class="region-link">View {r.name} Routes &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="hub-cta">
    <div class="container">
      <h2 class="cta-title">Ready to ship?</h2>
      <p class="cta-sub">Get an all-in DDP or FOB quote within 2 working hours. No hidden charges, no surcharge surprises.</p>
      <div class="cta-buttons">
        <a href="/contact/" class="btn btn-primary">Get a Free Quote</a>
        <a href="/faq/" class="btn btn-outline">Read FAQ</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero {
    position: relative; min-height: 380px;
    display: flex; align-items: center; color: #fff; overflow: hidden;
  }
  .hub-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hub-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .hub-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(135deg, rgba(11,42,74,0.92) 0%, rgba(18,58,99,0.85) 50%, rgba(30,111,217,0.78) 100%);
  }
  .hub-hero-content { position: relative; z-index: 2; max-width: 760px; padding-block: 48px; }
  .hub-hero-title {
    color: #fff; font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 800;
    margin: 16px 0 14px; letter-spacing: 0.5px;
  }
  .hub-hero-sub { color: #e7eff7; font-size: 1rem; line-height: 1.65; margin: 0 0 22px; }
  .hub-hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .breadcrumb-light { color: #cdd9e6; margin-bottom: 12px; }
  .breadcrumb-light a { color: #fff; }
  .breadcrumb-light a:hover { color: #fff; }

  .region-hub-section { padding-block: 56px; }
  .region-intro { max-width: 820px; margin-bottom: 32px; }
  .region-intro p { color: var(--ink-soft); line-height: 1.75; font-size: 1rem; }

  .region-grid { gap: 24px; }
  .region-card {
    color: inherit; text-decoration: none !important;
    display: flex; flex-direction: column;
    transition: all 0.2s ease;
    padding: 0; overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }
  .region-card-img { height: 200px; overflow: hidden; }
  .region-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .region-card:hover .region-card-img img { transform: scale(1.05); }
  .region-card-body { padding: 24px 22px; }
  .region-card:hover {
    box-shadow: 0 6px 20px rgba(11,42,74,0.1);
    transform: translateY(-2px);
    border-color: var(--blue);
  }
  .region-card h3 { font-size: 1.2rem; margin: 0 0 10px; color: var(--navy); }
  .region-card p {
    font-size: 0.9rem; line-height: 1.6; color: var(--ink-soft);
    margin: 0 0 16px; flex: 1;
  }
  .region-link {
    display: inline-block; color: var(--blue); font-weight: 700; font-size: 0.88rem;
  }
  .region-card:hover .region-link { color: var(--orange); }

  .hub-cta {
    background: var(--navy); color: #fff; padding-block: 56px; text-align: center;
  }
  .cta-title { color: #fff; font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 12px; }
  .cta-sub { color: #cdd9e6; max-width: 560px; margin: 0 auto 24px; font-size: 1rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .hub-cta .btn-outline { border-color: #fff; color: #fff; }
  .hub-cta .btn-outline:hover { background: rgba(255,255,255,0.12); color: #fff; }

  @media (max-width: 480px) {
    .region-card h3 { font-size: 1.05rem; }
    .region-card p { font-size: 0.85rem; }
    .region-card-img { height: 160px; }
    .cta-buttons { flex-direction: column; align-items: stretch; }
  }
</style>
