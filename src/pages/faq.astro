---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const faqs = [
  {
    category: 'About Dantful Logistics',
    items: [
      {
        q: 'Who is Dantful Logistics?',
        a: 'Dantful Logistics (SHENZHEN DANTFUL INT\'L LOGISTICS CO., LTD.) is a licensed NVOCC freight forwarder headquartered in Shenzhen, China. Since 2008, we have helped importers, Amazon sellers and wholesalers ship from Chinese factories to 120+ countries. We handle 38,000+ TEUs of ocean freight and 4,200+ tons of air cargo per year for 2,400+ active clients.',
      },
      {
        q: 'What licenses and certifications do you hold?',
        a: 'We hold: (1) NVOCC qualification filed with China\'s Ministry of Transport; (2) Class A Customs Brokerage License issued by China Customs; (3) ISO 9001 Quality Management Certification; (4) US AMS / ISF-10 filer registration; (5) EU EORI registration; (6) China Customs AEO certified export declaration agent.',
      },
      {
        q: 'How long has Dantful been in business?',
        a: '16+ years. Founded in 2008 in Shenzhen, we have grown from a small team to 80+ dedicated logistics specialists. Track record: 38,000+ TEUs shipped, 2,400+ active clients in 120+ countries, 98.6% on-time delivery rate, claims rate below 0.3%.',
      },
      {
        q: 'Where is your office located?',
        a: 'Our headquarters is at ' + SITE.address + '. Shenzhen is China\'s largest export port and a major air cargo hub. Clients are welcome to visit by appointment. We also have partner offices in Shanghai, Ningbo, Guangzhou, Qingdao and Hong Kong.',
      },
    ],
  },
  {
    category: 'Services & Coverage',
    items: [
      {
        q: 'What shipping services do you offer from China?',
        a: 'Six core services: (1) Ocean freight FCL & LCL consolidation; (2) Air freight (express/economy/charter); (3) Amazon FBA prep & shipping; (4) Licensed customs clearance; (5) Bonded warehousing (30,000 sqm in Shenzhen); (6) Door-to-door DDP solutions. Coverage: 120+ countries across 7 regions - North America, Europe, Middle East, Africa, Oceania, Southeast Asia, South America.',
      },
      {
        q: 'Which China ports and airports can you ship from?',
        a: 'All major China ports: Shanghai, Ningbo, Shenzhen (Yantian, Shekou, Chiwan), Qingdao, Tianjin, Guangzhou Nansha, Xiamen, Fuzhou and Hong Kong. Airports: PVG (Shanghai Pudong), CAN (Guangzhou Baiyun), SZX (Shenzhen Bao\'an), HKG (Hong Kong). We also do factory pickup from any city in mainland China.',
      },
      {
        q: 'Can you handle special cargo (batteries, magnets, cosmetics, food, branded goods)?',
        a: 'Yes. Team trained and certified for: (1) Lithium batteries (MSDS + UN38.3 reports, UN3480/3481/3090/3091); (2) Magnetic items (degaussing certificate); (3) Cosmetics (CIQ health cert + FDA pre-notification); (4) Food & beverages (CIQ + health cert); (5) Medical devices (NMPA, CE, FDA); (6) Branded goods (trademark authorization letter). DG cargo (Class 3, 4, 5, 6, 8, 9) also accepted.',
      },
    ],
  },
  {
    category: 'Pricing & Quoting',
    items: [
      {
        q: 'How do I get a quote?',
        a: 'Submit cargo details via our Contact form, email (overseas.27@dantful.com), or WhatsApp (+86 15143552568). Please provide: cargo name, weight (KG), volume (CBM), origin city, destination port/airport/address, Incoterm (FOB/EXW/DDP), special handling needs. We send an all-in quote within 2 working hours.',
      },
      {
        q: 'Are there any hidden charges?',
        a: 'No. Our DDP all-in pricing is fully itemized: factory pickup, trucking, export customs declaration, origin port charges, ocean/air freight, destination port charges, import customs clearance, duties/taxes, and last-mile delivery. Every cost shown on the quote - no surprise add-ons after booking. LCL quotes also specify per-CBM rate, minimum chargeable weight, and LCL consolidation fee.',
      },
      {
        q: 'What payment methods do you accept?',
        a: 'We accept Alipay, Western Union, Hong Kong bank transfers, and local African bank accounts (Nigeria, Kenya, Ghana, South Africa and other African markets). Full payment is required before vessel/flight departure - no balance-against-B/L copy option. This simplifies customs and ensures smooth on-time sailing.',
      },
    ],
  },
  {
    category: 'Amazon FBA Shipping',
    items: [
      {
        q: 'Do you ship to Amazon FBA fulfillment centers worldwide?',
        a: 'Yes. We deliver to major FBA warehouses globally - US (ONT8, LGB8, LAX9, EWR4, BFI3, MEM1, FTW1, MIA1), Canada (YYZ4, YVR2), UK (BHX4, LTN4), Germany (DTM1, MST1, LEJ1, XDEB), France (ORY1), Italy (MXP1), Japan (NRT1, KIX1), Australia (SYD1, MEL1). Direct FC appointments via UPS, FedEx and Amazon-partnered trucking.',
      },
      {
        q: 'What FBA prep services do you offer?',
        a: 'Full FBA prep at our Shenzhen bonded warehouse: FNSKU labeling, poly-bagging, bubble wrap, palletization, product inspection, stickering, bundling, repackaging, quality control. Free 30-day storage while you accumulate stock from multiple suppliers. All prep meets Amazon\'s FBA Inventory Requirements (TIPP).',
      },
      {
        q: 'How does DDP shipping to Amazon FBA work?',
        a: 'We pre-pay all US import duties, Merchandise Processing Fee (MPF), Harbor Maintenance Fee (HMF), customs bond, ISF-10 filing, and freight. Cargo clears US customs under our brokerage, then trucks direct to the FBA FC appointment. You get a hands-off delivery to FBA - no customs paperwork, no duty payments, no port coordination. Same service for EU (DDP + EORI), UK, Canada, Australia and Japan FBA.',
      },
    ],
  },
  {
    category: 'Tracking & Insurance',
    items: [
      {
        q: 'How can I track my shipment?',
        a: 'Every shipment gets a tracking number (B/L or AWB) within 24 hours of vessel/flight departure. You receive: (1) weekly progress emails with vessel position, ETA, clearance status; (2) WeChat/WhatsApp real-time alerts for key milestones (pickup, sailing, arrival, customs, delivery); (3) 24/7 access to your dedicated coordinator via phone/email/WhatsApp. Container tracking supports Maersk, MSC, COSCO, ONE, Evergreen, CMA CGM directly.',
      },
      {
        q: 'Is my cargo insured? What coverage is included?',
        a: 'Cargo insurance is optional and can be purchased separately based on your needs. The premium rate is calculated according to your declared cargo value - higher value goods carry a proportionally adjusted rate. We offer All-Risks coverage underwritten by Ping An Insurance, PICC, or Lloyd\'s syndicates. To add insurance, simply inform your coordinator when booking - the premium will be itemized on your quote. We strongly recommend purchasing insurance for high-value, fragile, or time-sensitive cargo.',
      },
      {
        q: 'What happens if my cargo is damaged or lost?',
        a: 'File a claim within 7 days of delivery with photos and brief description. Our team responds within 48 hours. Insurance settlements typically resolve in 15-30 days. Over 17 years and 80,000+ TEUs shipped, our claims rate is below 0.3% - well below industry average. We also help with carrier claims (3-month SOL) for ocean freight and airway bill disputes.',
      },
    ],
  },
  {
    category: 'Order Process',
    items: [
      {
        q: 'What is your order process?',
        a: '7-step process: (1) Send inquiry with cargo details; (2) Receive all-in quote within 2 working hours; (3) Confirm booking with PI; (4) Factory pickup by our trucking; (5) Export customs declaration + CIQ inspection; (6) Vessel/flight departs with tracking activated; (7) Destination import clearance + last-mile delivery. You get one dedicated coordinator throughout - no hand-offs between departments.',
      },
      {
        q: 'What is your minimum order volume?',
        a: 'No strict minimum. LCL consolidation starts from 0.1 CBM. Air freight from 1 kg. For FCL, we recommend 8+ CBM to be cost-effective. Sample orders, small e-commerce parcels, and personal effects are all welcome. We consolidate multiple suppliers\' cargo into single shipments to lower per-unit shipping cost.',
      },
      {
        q: 'Can you consolidate multiple suppliers into one shipment?',
        a: 'Yes - one of our core strengths. Our 30,000 sqm bonded warehouse in Shenzhen consolidates cargo from unlimited suppliers. Services include: free 30-day storage, cargo inspection, repacking, relabeling, quality control, carton sorting. Consolidation cuts per-CBM LCL cost by 30-60% vs. shipping each supplier separately. Ideal for Amazon sellers, dropshippers, SMEs sourcing from Yiwu, Dongguan, Shenzhen, Foshan.',
      },
      {
        q: 'How far in advance should I book?',
        a: 'For FCL ocean freight: 7-10 days before vessel ETD. For LCL consolidation: 5 days. For air freight: 1-3 days. Peak season (Pre-CNY in Jan-Feb, Prime Day in July, Black Friday in Nov): 14-21 days recommended to secure vessel/airline space and avoid surcharges. We also offer space-reservation contracts for clients with regular monthly volume.',
      },
    ],
  },
  {
    category: 'Shipping Times & Routes',
    items: [
      {
        q: 'How long does shipping from China to USA take?',
        a: 'Sea FCL to US West Coast (Los Angeles, Long Beach) takes 14-20 days. To US East Coast (New York, Savannah) 26-32 days via Panama Canal. Air freight 3-5 days. Sea express + truck DDP to Amazon FBA fulfillment centers 22-30 days. See our <a href="/routes/china-to-usa/">China to USA shipping route</a> for a full transit time table and price factors.',
      },
      {
        q: 'How long does sea freight from China to Europe take?',
        a: 'North Europe (Rotterdam, Hamburg, Antwerp) 30-38 days port-to-port. Mediterranean (Genoa, Barcelona, Piraeus) 32-40 days. UK (Felixstowe, Tilbury) 28-35 days. Door-to-door DDP adds 4-7 days for import clearance and inland trucking. See our <a href="/services/ocean-freight/">Ocean Freight service page</a> for the full transit time table by origin and destination port.',
      },
      {
        q: 'How long does air freight from China take?',
        a: 'Express air 1-3 days direct flight with priority handling. Economy air 3-7 days consolidated at lower rates. Our block-space agreements with 40+ airlines (Air China Cargo, Lufthansa, Emirates, Qatar Airways, Turkish Cargo, Cargolux) guarantee uplift even during Q4 peak season. See <a href="/services/air-freight/">Air Freight service</a> for service levels, pricing and special cargo capabilities.',
      },
      {
        q: 'What is the fastest shipping method from China?',
        a: 'Air express via DHL, UPS or FedEx delivers in 3-5 days door-to-door for parcels under 300 KG. For urgent Amazon FBA replenishment we also offer air charter options on B737, B767 or B747 freighters - a charter can be airborne within 24 hours of booking. For heavy or bulky cargo where air is too costly, sea express + expedited trucking reaches US FBA in 22-25 days at a fraction of the air rate.',
      },
    ],
  },
  {
    category: 'Incoterms & Documentation',
    items: [
      {
        q: 'What documents are needed for shipping from China?',
        a: 'Standard set: (1) Commercial Invoice; (2) Packing List; (3) Sales Contract or Proforma Invoice; (4) Booking Note; (5) Bill of Lading (sea) or Air Waybill (air); (6) Certificate of Origin (CO, FORM A, FORM E, FORM F or FORM RCEP for FTA duty preference); (7) Export Customs Declaration; (8) CIQ inspection certificate for restricted goods. Special cargo adds: MSDS + UN38.3 for lithium batteries, degaussing certificate for magnetic items, trademark authorization for branded goods, NMPA/CE/FDA for medical devices. Our <a href="/services/customs-clearance/">licensed customs brokerage</a> prepares all documents on your behalf.',
      },
      {
        q: 'What is DDP shipping from China?',
        a: 'DDP (Delivered Duty Paid) means the seller - in this case Dantful - covers all costs and risks to the named destination: factory pickup, trucking, export customs, ocean or air freight, destination port charges, import customs clearance, duties and taxes, and last-mile delivery. The buyer receives goods at their door with zero customs paperwork. DDP is ideal for Amazon FBA sellers, first-time importers, and clients who want a fully hands-off experience. We offer DDP to USA, EU 27, UK, Canada, Australia, Japan and Mexico.',
      },
      {
        q: 'What is the difference between FOB and CIF?',
        a: 'FOB (Free On Board): the seller delivers cargo loaded on board the vessel at the named Chinese port. From that point the buyer pays ocean freight, insurance, import clearance and duties. CIF (Cost, Insurance & Freight): the seller pays ocean freight and minimum insurance to the destination port, but the buyer still pays import clearance and duties. FOB is common for FCL shipments where the buyer controls carrier routing. CIF is preferred when the buyer wants the seller to arrange freight. Read our <a href="/resources/incoterms/">Incoterms guide</a> for a full comparison of FOB, CIF, DAP and DDP.',
      },
      {
        q: 'What is the difference between DAP and DDP shipping?',
        a: 'DAP (Delivered at Place): the seller delivers to the named destination, but the buyer pays import duties, VAT and customs clearance. DDP (Delivered Duty Paid): the seller pays everything including duties and taxes. DDP is more hands-off for the buyer. DAP is preferred when the buyer wants to control customs, claim input VAT, or use their own broker. For Amazon FBA shipments DDP is effectively mandatory because Amazon does not act as importer of record. See our <a href="/resources/incoterms/">Incoterms guide</a> for the full FOB / CIF / DAP / DDP comparison.',
      },
      {
        q: 'What is a House Bill of Lading (HBL)?',
        a: 'A House Bill of Lading (HBL) is issued by an NVOCC freight forwarder like Dantful to the shipper. It serves three functions: (1) receipt for cargo received; (2) evidence of the contract of carriage; (3) document of title. The Master Bill of Lading (MBL) is issued by the actual carrier (Maersk, MSC, COSCO) to the NVOCC. At destination, the consignee uses the HBL to claim cargo from the forwarder agent. As a licensed NVOCC, we issue HBLs with telex release or original options. Read our <a href="/resources/house-bill-of-lading/">House B/L guide</a> for the full HBL vs MBL breakdown and when to use telex release.',
      },
    ],
  },
  {
    category: 'Choosing a Freight Forwarder',
    items: [
      {
        q: 'How to choose a freight forwarder in China?',
        a: 'Check for: (1) NVOCC qualification filed with China Ministry of Transport; (2) Class A Customs Brokerage License from GACC; (3) 5+ years in business with verifiable client references; (4) transparent all-in pricing with no hidden surcharges; (5) a dedicated coordinator - not a rotating support queue; (6) real-time shipment tracking with B/L or AWB numbers; (7) a bonded warehouse for consolidation and FBA prep; (8) FMC OTI registration if shipping to USA. Avoid forwarders who cannot show an NVOCC number, quote suspiciously low rates, or refuse to itemize charges. See our <a href="/about/credentials/">credentials page</a> for our licenses and certifications.',
      },
      {
        q: 'Do I need a freight forwarder to import from China?',
        a: 'Legally no, but practically yes. A freight forwarder consolidates carrier booking, customs brokerage, warehousing, trucking and insurance into one contract. Doing it yourself means coordinating 4-6 vendors, filing ISF-10, AMS and ENS yourself, and missing out on volume discounts. A forwarder like Dantful typically saves 20-40% on landed cost versus DIY, and reduces the risk of customs holds, missed sailings and duty overpayment. For Amazon FBA, a forwarder with FBA prep capability is essential - Amazon rejects non-compliant shipments at the FC dock.',
      },
      {
        q: 'What is the difference between FCL and LCL shipping?',
        a: 'FCL (Full Container Load) means your cargo fills a 20GP, 40GP or 40HQ container. You pay a flat rate per container regardless of how full it is. Transit is faster because there is no consolidation or deconsolidation. LCL (Less than Container Load) means your cargo shares a container with other shipments. You pay per CBM (cubic meter). LCL is cheaper for shipments under 15 CBM. FCL is cheaper for shipments over 15 CBM and offers lower per-CBM cost. See our <a href="/services/fcl-vs-lcl/">FCL vs LCL guide</a> for a detailed cost and transit comparison.',
      },
      {
        q: 'How much does it cost to ship a container from China to USA?',
        a: 'A 40HQ container from Shenzhen Yantian to Los Angeles starts around [USD XXXX per 40HQ] in low season, rising 30-60% during Q4 peak season (Sep-Dec). A 20GP starts around [USD XXXX per 20GP]. LCL consolidation starts around [USD X.X per CBM] with a 1 CBM minimum. Rates vary by destination, season, carrier, BAF and PSS. We quote transparent all-in rates with no hidden surcharges. <a href="/contact/">Request a quote</a> for a confirmed rate within 2 working hours.',
      },
      {
        q: 'How much does a freight forwarder charge?',
        a: 'Freight forwarder charges depend on service scope. For FCL ocean freight, the forwarder adds a margin on top of the carrier rate - typically 5-15% for standard lanes, lower for high-volume clients under annual contracts. For LCL, the forwarder charges per CBM including origin charges, ocean freight and destination charges. For DDP door-to-door, the all-in rate covers pickup, export, freight, import clearance, duties and delivery. Air freight is charged per KG (actual or volumetric, whichever is higher). We provide fully itemized quotes so every cost line is visible before booking.',
      },
    ],
  },
];

// 生成 FAQ Schema 结构化数据（Google 富片段关键）
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    }))
  ),
});

const tocItems = faqs.map((group) => ({
  id: group.category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
  label: group.category,
  count: group.items.length,
}));
---

<BaseLayout
  title="FAQ - Freight Forwarding from China | Dantful"
  description="Answers to common questions about Dantful Logistics - China freight forwarder since 2008. Services, pricing, Amazon FBA shipping, tracking, insurance and order process."
>
  <section class="faq-hero">
    <div class="faq-hero-bg">
      <img src="/images/faq-hero.webp" alt="Dantful Logistics freight forwarding services - FAQ" loading="eager" />
    </div>
    <div class="faq-hero-overlay"></div>
    <div class="container faq-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>FAQ</span>
      </nav>
      <h1 class="faq-hero-title">FREQUENTLY ASKED QUESTIONS</h1>
      <p class="faq-hero-sub">Everything you need to know about shipping from China with Dantful Logistics - company credentials, services, pricing transparency, Amazon FBA, cargo protection and order process. Find clear answers below, or contact us for a personalized quote within 2 working hours.</p>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="faq-layout">
        <aside class="faq-toc" aria-label="FAQ categories">
          <h2 class="faq-toc-title">Categories</h2>
          <ul>
            {tocItems.map((t) => (
              <li>
                <a href={`#${t.id}`}>
                  <span>{t.label}</span>
                  <span class="faq-toc-count">{t.count}</span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/contact/" class="btn btn-primary faq-toc-cta">Get a Quote</a>
        </aside>

        <div class="faq-content">
          {faqs.map((group) => {
            const groupId = group.category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
            return (
              <div class="faq-group" id={groupId}>
                <h2 class="faq-group-title">{group.category}</h2>
                {group.items.map((item) => (
                  <details class="faq-item">
                    <summary class="faq-q">
                      <span class="faq-q-text">{item.q}</span>
                      <span class="faq-q-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      </span>
                    </summary>
                    <div class="faq-a">
                      <p set:html={item.a} />
                    </div>
                  </details>
                ))}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="faq-cta">
    <div class="container">
      <h2 class="cta-title">Still have questions?</h2>
      <p class="cta-sub">Get a tailored quote within 2 working hours. Our logistics coordinators reply to every inquiry - no auto-responses, no spam.</p>
      <div class="cta-buttons">
        <a href="/contact/" class="btn btn-primary">Get a Free Quote</a>
        <a href={`https://wa.me/${SITE.phone.replace(/[^\d]/g, '')}`} target="_blank" rel="noopener noreferrer" class="btn btn-outline">WhatsApp Us</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={faqJsonLd} />
</BaseLayout>

<style>
  /* ============ Hero Banner ============ */
  .faq-hero {
    position: relative;
    min-height: 340px;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
  }
  .faq-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .faq-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .faq-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(135deg, rgba(11, 42, 74, 0.92) 0%, rgba(18, 58, 99, 0.85) 50%, rgba(30, 111, 217, 0.78) 100%);
  }
  .faq-hero-content { position: relative; z-index: 2; padding-block: 48px; }
  .faq-hero-title {
    color: #fff; font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800; margin: 0 0 14px; letter-spacing: 0.5px;
  }
  .faq-hero-sub {
    color: #e7eff7; font-size: 1rem; max-width: 760px;
    margin: 0; line-height: 1.65;
  }
  .breadcrumb-light { color: #cdd9e6; }
  .breadcrumb-light a { color: #fff; }

  /* ============ FAQ 主布局 ============ */
  .faq-section { padding-block: 64px; background: var(--bg-soft); }
  .faq-layout { display: grid; grid-template-columns: 260px 1fr; gap: 36px; align-items: start; }

  /* ============ 左侧目录 ============ */
  .faq-toc {
    position: sticky; top: 100px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    padding: 22px 18px; box-shadow: 0 2px 10px rgba(11, 42, 74, 0.05);
  }
  .faq-toc-title { font-size: 1.05rem; margin: 0 0 14px; }
  .faq-toc ul { list-style: none; padding: 0; margin: 0 0 20px; }
  .faq-toc li { margin: 0; }
  .faq-toc a {
    display: flex; justify-content: space-between; align-items: center;
    padding: 9px 12px; border-radius: 6px; color: var(--ink-soft);
    font-size: 0.88rem; font-weight: 600; text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .faq-toc a:hover { background: var(--blue-light); color: var(--navy); }
  .faq-toc-count {
    background: var(--blue-light); color: var(--blue);
    font-size: 0.78rem; padding: 2px 8px; border-radius: 10px;
  }
  .faq-toc-cta { width: 100%; }

  /* ============ 右侧 FAQ 内容 ============ */
  .faq-group { margin-bottom: 36px; }
  .faq-group:last-child { margin-bottom: 0; }
  .faq-group-title {
    font-size: 1.35rem; margin: 0 0 18px;
    padding-bottom: 10px; border-bottom: 2px solid var(--blue);
    color: var(--navy);
  }
  .faq-item {
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    margin-bottom: 10px; overflow: hidden;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .faq-item[open] {
    border-color: var(--blue);
    box-shadow: 0 4px 14px rgba(11, 42, 74, 0.08);
  }
  .faq-item:last-child { margin-bottom: 0; }

  .faq-q {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 16px 20px; cursor: pointer; list-style: none;
    font-weight: 700; color: var(--navy); font-size: 0.98rem;
    line-height: 1.4; user-select: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q-text { flex: 1; }
  .faq-q-icon {
    flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
    background: var(--blue-light); color: var(--blue);
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .faq-q-icon svg { width: 16px; height: 16px; }
  .faq-item[open] .faq-q-icon {
    transform: rotate(45deg); background: var(--orange); color: #fff;
  }

  .faq-a { padding: 0 20px 18px; color: var(--ink-soft); line-height: 1.7; }
  .faq-a p { margin: 0; font-size: 0.94rem; }

  /* ============ CTA 板块 ============ */
  .faq-cta {
    background: var(--navy); color: #fff; padding-block: 64px;
    text-align: center;
  }
  .cta-title { color: #fff; font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 12px; }
  .cta-sub { color: #cdd9e6; max-width: 560px; margin: 0 auto 24px; font-size: 1rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .faq-cta .btn-outline { border-color: #fff; color: #fff; }
  .faq-cta .btn-outline:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }

