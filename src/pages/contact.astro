---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../consts';
---

<BaseLayout
  title="Contact | Get a Free Freight Quote in 24h"
  description={`Contact ${SITE.name} for freight quotes from China. Email, phone — we reply within 24 hours.`}
>
  <section class="contact-hero">
    <div class="contact-hero-bg">
      <img src="/images/services-hero.jpg" alt="Contact Dantful Logistics for freight quotes from China" loading="eager" />
    </div>
    <div class="contact-hero-overlay"></div>
    <div class="container contact-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Contact</span>
      </nav>
      <h1 class="contact-hero-title">CONTACT US</h1>
      <p class="contact-hero-sub">Tell us about your shipment and get a tailored quote within 24 hours.</p>
    </div>
  </section>

  <section>
    <div class="container">

      <div class="grid grid-2 contact-grid">
        <div class="prose">
          <h2>Direct Contact</h2>
          <ul class="contact-list">
            <li><strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><strong>Phone:</strong> <a href={`tel:${SITE.phone.replace(/[\s-]/g, '')}`}>{SITE.phone}</a></li>
            <li><strong>Address:</strong> {SITE.address}</li>
            <li><strong>Working Hours:</strong> Mon–Sat 9:00–19:00 Beijing Time (GMT+8)</li>
          </ul>

          
          <iframe src="https://www.google.com/maps?q=Wenhua+Building,+No.1027+Shennan+East+Road,+Luohu,+Shenzhen&amp;output=embed" width="100%" height="260" style="border:0;border-radius:var(--radius);margin:20px 0 30px;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>

          <h2>What to Include in Your Inquiry</h2>
          <ul>
            <li>Pickup city / supplier address in China</li>
            <li>Destination port or door address</li>
            <li>Cargo description, quantity, weight &amp; volume (CBM)</li>
            <li>Incoterms (EXW / FOB / CIF / DDP …)</li>
          </ul>
        </div>
        <div></div>
      </div>
    </div>
  </section>

  <QuoteForm compact />
</BaseLayout>

<style>
  .contact-hero {
    position: relative; min-height: 280px; display: flex; align-items: center;
    overflow: hidden; padding: 60px 0 48px;
  }
  .contact-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .contact-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .contact-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(135deg, rgba(11,42,74,0.85) 0%, rgba(11,42,74,0.6) 60%, rgba(11,42,74,0.35) 100%);
  }
  .contact-hero-content { position: relative; z-index: 2; max-width: 760px; }
  .contact-hero-title { color: #fff; font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; margin: 16px 0 14px; letter-spacing: 0.3px; }
  .contact-hero-sub { color: rgba(255,255,255,0.9); font-size: 1rem; line-height: 1.7; margin: 0; }
  .breadcrumb-light a, .breadcrumb-light span { color: rgba(255,255,255,0.85); }
  .breadcrumb-light a:hover { color: #fff; }

  .contact-grid { gap: 48px; align-items: start; }
  .contact-list { list-style: none; padding: 0; margin: 14px 0 28px; }
  .contact-list li { margin-bottom: 12px; color: var(--ink-soft); line-height: 1.6; }
  .contact-list a { min-height: 44px; display: inline-flex; align-items: center; }
  @media (max-width: 720px) {
    .contact-grid { gap: 32px; }
    .contact-list li { margin-bottom: 10px; font-size: 0.9rem; }
  }
  @media (max-width: 480px) {
    .contact-grid { gap: 24px; }
    iframe { height: 200px !important; }
  }
</style>
