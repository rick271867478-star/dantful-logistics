---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

const title = 'Shipping Resources & Guides | Dantful';
const description = 'Free shipping resources and guides from Dantful Logistics. Learn about House Bill of Lading, Incoterms 2020 (FOB, CIF, DAP, DDP), FCL vs LCL shipping, and our company credentials.';
const waNumber = SITE.phone.replace(/[^\d]/g, '');

const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: '/resources/' }
  ]
});

const resources = [
  {
    title: 'House Bill of Lading (HBL) Guide',
    desc: 'Understand the difference between House B/L and Master B/L, when to use telex release vs original, and how an NVOCC-issued HBL protects your cargo rights.',
    href: '/resources/house-bill-of-lading/',
    img: '/images/resource-house-bl-hero.webp',
    alt: 'House Bill of Lading document guide - shipping form on desk with container tracking'
  },
  {
    title: 'Incoterms 2020 Guide: FOB, CIF, DAP, DDP',
    desc: 'Complete guide to international trade terms. Learn the difference between FOB and CIF, DAP vs DDP, who bears risk and cost at each stage, and which Incoterm suits your shipment.',
    href: '/resources/incoterms/',
    img: '/images/resource-incoterms-hero.webp',
    alt: 'Incoterms 2020 trade terms FOB CIF DAP DDP guide - shipping container at port'
  },
  {
    title: 'FCL vs LCL: Which Is Cheaper?',
    desc: 'Full Container Load or Less than Container Load? Compare costs, transit times, and when each option saves you money. Includes a CBM-to-container calculator.',
    href: '/services/fcl-vs-lcl/',
    img: '/images/service-fcl-vs-lcl-hero.webp',
    alt: 'FCL vs LCL shipping comparison - full container load and less than container load'
  },
  {
    title: 'Dantful Logistics Credentials',
    desc: 'Our NVOCC license, Class-A customs brokerage, FMC OTI registration, ISO 9001 certification, and AEO status. Verify our qualifications as a China freight forwarder.',
    href: '/about/credentials/',
    img: '/images/about-credentials-hero.webp',
    alt: 'Dantful Logistics credentials - office with NVOCC license and ISO 9001 certificates'
  },
  {
    title: 'Shipping FAQ',
    desc: 'Answers to the 31 most-asked questions about shipping from China: transit times, costs, documents, Incoterms, Amazon FBA, customs clearance, and choosing a forwarder.',
    href: '/faq/',
    img: '/images/faq-hero.webp',
    alt: 'Shipping FAQ page - freight forwarding questions and answers'
  },
  {
    title: 'Global Shipping Routes',
    desc: 'Overview of our shipping routes from China to North America, Europe, UK, Australia, Canada, Singapore, Middle East, Africa, Russia and Central Asia.',
    href: '/routes/',
    img: '/images/routes-hero.webp',
    alt: 'Global shipping routes from China - container port with cargo ships'
  }
];
---

<BaseLayout {title} {description}>
  <section class="route-hero">
    <div class="route-hero-bg">
      <img src="/images/routes-hero.webp" alt="Shipping resources and guides from China - container terminal with global logistics" loading="eager" />
    </div>
    <div class="route-hero-overlay"></div>
    <div class="container route-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Resources</span>
      </nav>
      <h1>Shipping Resources &amp; Guides</h1>
      <p class="route-hero-sub">Free guides to help you understand freight forwarding from China. Bill of Lading, Incoterms 2020, FCL vs LCL, customs documents, and our company credentials. Written by licensed NVOCC and Class-A customs brokers with 16+ years of experience.</p>
      <div class="route-hero-cta">
        <a href="/contact/" class="btn btn-primary">Get a Quote</a>
        <a href="/faq/" class="btn btn-outline">Read FAQ</a>
      </div>
    </div>
  </section>

  <section class="resources-section">
    <div class="container">
      <div class="resources-grid">
        {resources.map((r) => (
          <a href={r.href} class="resource-card">
            <div class="resource-card-img">
              <img src={r.img} alt={r.alt} loading="lazy" />
            </div>
            <div class="resource-card-body">
              <h2>{r.title}</h2>
              <p>{r.desc}</p>
              <span class="resource-link">Read Guide &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="hub-cta">
    <div class="container">
      <h2 class="cta-title">Need help with your shipment?</h2>
      <p class="cta-sub">Get an all-in DDP or FOB quote within 2 working hours. No hidden charges, no surcharge surprises.</p>
      <div class="cta-buttons">
        <a href="/contact/" class="btn btn-primary">Get a Free Quote</a>
        <a href={`https://wa.me/${waNumber}`} class="btn btn-outline" target="_blank" rel="noopener">WhatsApp Us</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
</BaseLayout>

<style>
  .route-hero { position: relative; min-height: 380px; display: flex; align-items: center; color: #fff; overflow: hidden; }
  .route-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .route-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .route-hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(135deg, rgba(11,42,74,0.92) 0%, rgba(18,58,99,0.85) 50%, rgba(30,111,217,0.78) 100%); }
  .route-hero-content { position: relative; z-index: 2; max-width: 760px; padding-block: 48px; }
  .route-hero h1 { color: #fff; font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 800; margin: 16px 0 14px; }
  .route-hero-sub { color: #e7eff7; font-size: 1rem; line-height: 1.65; margin: 0 0 22px; }
  .route-hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .breadcrumb-light { color: #cdd9e6; margin-bottom: 12px; }
  .breadcrumb-light a { color: #fff; }
  .breadcrumb-light a:hover { color: #fff; }

  .resources-section { padding-block: 56px; }
  .resources-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px; }
  .resource-card { color: inherit; text-decoration: none !important; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; overflow: hidden; transition: all 0.2s ease; }
  .resource-card-img { height: 200px; overflow: hidden; }
  .resource-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .resource-card:hover .resource-card-img img { transform: scale(1.05); }
  .resource-card-body { padding: 24px 22px; }
  .resource-card:hover { box-shadow: 0 6px 20px rgba(11,42,74,0.1); transform: translateY(-2px); border-color: var(--blue); }
  .resource-card h2 { font-size: 1.2rem; margin: 0 0 10px; color: var(--navy); }
  .resource-card p { font-size: 0.9rem; line-height: 1.6; color: var(--ink-soft); margin: 0 0 16px; }
  .resource-link { display: inline-block; color: var(--blue); font-weight: 700; font-size: 0.88rem; }
  .resource-card:hover .resource-link { color: var(--orange); }

  .hub-cta { background: var(--navy); color: #fff; padding-block: 56px; text-align: center; }
  .cta-title { color: #fff; font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 12px; }
  .cta-sub { color: #cdd9e6; max-width: 560px; margin: 0 auto 24px; font-size: 1rem; }
  .cta-buttons { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .hub-cta .btn-outline { border-color: #fff; color: #fff; }
  .hub-cta .btn-outline:hover { background: rgba(255,255,255,0.12); color: #fff; }

  @media (max-width: 480px) {
    .resource-card h2 { font-size: 1.05rem; }
    .resource-card p { font-size: 0.85rem; }
    .resource-card-img { height: 160px; }
    .cta-buttons { flex-direction: column; align-items: stretch; }
  }
</style>
