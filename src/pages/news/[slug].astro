---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { news } from '../../data/news';
import { regions } from '../../data/regions';

export function getStaticPaths() {
  return news
    .filter((n) => n.body)
    .map((n) => ({ params: { slug: n.slug }, props: { item: n } }));
}

const { item } = Astro.props;
const regionName = item.region ? regions.find(r => r.slug === item.region)?.name : null;
const relatedNews = news
  .filter((n) => n.slug !== item.slug)
  .sort((a, b) => {
    // 优先同 region
    if (item.region) {
      if (a.region === item.region && b.region !== item.region) return -1;
      if (b.region === item.region && a.region !== item.region) return 1;
    }
    // 其次同 category
    if (a.category === item.category && b.category !== item.category) return -1;
    if (b.category === item.category && a.category !== item.category) return 1;
    return 0;
  })
  .slice(0, 3);
---

<BaseLayout title={item.title} description={item.summary}>
  <section class="article-hero">
    <div class="article-hero-bg">
      <img src={item.region ? `/images/region-${item.region}.jpg` : "/images/news-hero.jpg"} alt={item.title} loading="eager" />
    </div>
    <div class="article-hero-overlay"></div>
    <div class="container article-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/news/">News</a> / <span>{item.category}</span>{regionName && <Fragment> / <span>{regionName}</span></Fragment>}
      </nav>
      <span class="news-cat">{item.category}</span>
      <time class="news-date">{item.date}</time>
      <h1 class="article-hero-title">{item.title}</h1>
    </div>
  </section>

  <section>
    <div class="container">

      <div class="prose article-body" style="max-width: 760px">
        {item.body!.map((html) => <Fragment set:html={html} />)}
      </div>

      {regionName && (
        <p style="margin-top: 20px;">
          <a href={`/ship-by-region/${item.region}/`} style="color: var(--blue); text-decoration: underline;">
            More about shipping to {regionName} &rarr;
          </a>
        </p>
      )}

      <div class="article-cta">
        <a href="/contact/" class="btn btn-primary">Get a Quote in 2 Hours</a>
        <a href="/services/ocean-freight/" class="btn btn-outline">Ocean Freight</a>
        <a href="/services/amazon-fba/" class="btn btn-outline">Amazon FBA Prep</a>
      </div>
    </div>
  </section>

  {relatedNews.length > 0 && (
    <section class="section-soft">
      <div class="container">
        <h2 class="section-title">Related Articles</h2>
        <div class="grid grid-3">
          {relatedNews.map((n) => (
            <a class="card news-card" href={`/news/${n.slug}/`}>
              <time>{n.date}</time>
              <h3>{n.title}</h3>
              <p>{n.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .article-hero {
    position: relative; min-height: 320px; display: flex; align-items: center;
    overflow: hidden; padding: 60px 0 48px;
  }
  .article-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .article-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .article-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(135deg, rgba(11,42,74,0.85) 0%, rgba(11,42,74,0.6) 60%, rgba(11,42,74,0.35) 100%);
  }
  .article-hero-content { position: relative; z-index: 2; max-width: 820px; }
  .article-hero-title {
    color: #fff; font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 800;
    margin: 14px 0 0; line-height: 1.3; max-width: 760px;
  }
  .breadcrumb-light a, .breadcrumb-light span { color: rgba(255,255,255,0.85); }
  .breadcrumb-light a:hover { color: #fff; }
  .news-cat {
    display: inline-block; font-size: 0.82rem; font-weight: 700; color: var(--blue);
    background: var(--blue-light); padding: 3px 12px; border-radius: 10px;
  }
  .news-date { font-size: 0.82rem; color: var(--ink-soft); margin-left: 10px; }
  .article-body { margin-top: 24px; }
  .article-body :global(h2) { margin: 28px 0 12px; font-size: 1.4rem; color: var(--navy); }
  .article-body :global(h3) { margin: 22px 0 8px; font-size: 1.15rem; color: var(--navy); }
  .article-body :global(p) { margin: 0 0 14px; color: var(--ink-soft); line-height: 1.7; }
  .article-body :global(a) { color: var(--blue); text-decoration: underline; }
  .article-body :global(a:hover) { color: var(--orange); }
  .article-cta { margin-top: 36px; display: flex; gap: 12px; flex-wrap: wrap; }
  .news-card { color: inherit; text-decoration: none !important; }
  .news-card time { color: var(--blue); font-size: 0.82rem; font-weight: 700; }
  .news-card h3 { margin: 8px 0; font-size: 1.05rem; line-height: 1.4; }
  .news-card p { font-size: 0.9rem; line-height: 1.6; color: var(--ink-soft); }
</style>
