---
import BaseLayout from '../layouts/BaseLayout.astro';
import { news, newsCategories, newsRegions } from '../data/news';
import { regions } from '../data/regions';

const regionName = (slug: string) => regions.find(r => r.slug === slug)?.name || slug;
---

<BaseLayout
  title="News & Freight Industry Updates"
  description="Company news, freight industry updates and practical shipping guides from China — container rates, port situations and export know-how."
>
  <section class="news-hero">
    <div class="news-hero-bg">
      <img src="/images/news-hero.jpg" alt="Freight industry news and shipping updates from China" loading="eager" />
    </div>
    <div class="news-hero-overlay"></div>
    <div class="container news-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>News</span>
      </nav>
      <h1 class="news-hero-title">NEWS</h1>
      <p class="news-hero-sub">Company updates, freight industry insights and practical shipping guides from China -- covering container rates, port situations, Amazon FBA know-how, customs regulations and export logistics best practices for importers worldwide.</p>
    </div>
  </section>

  <section>
    <div class="container">

      {newsCategories.map((cat) => (
        <section id={cat.toLowerCase().replace(/ /g, '-')} style="padding-block: 36px;">
          <h2 style="border-bottom: 2px solid var(--line); padding-bottom: 10px;">{cat}</h2>
          <div class="grid grid-2">
            {news.filter((n) => n.category === cat).map((n) => (
              <article class="card news-card">
                <time datetime={n.date}>{n.date}</time>
                {n.region && <span class="news-region-chip">{regionName(n.region)}</span>}
                <h3>{n.title}</h3>
                <p>{n.summary}</p>
                {n.body && <a href={`/news/${n.slug}/`} class="read-more">Read more &rarr;</a>}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section-soft" style="padding-block: 36px;">
    <div class="container">
      <h2 class="section-title" style="text-align:left;font-size:1.4rem;">Browse News by Region</h2>
      <div class="region-chips">
        {newsRegions.map((slug) => (
          <a href={`/ship-by-region/${slug}/`} class="region-chip">{regionName(slug)}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .news-hero {
    position: relative; min-height: 300px; display: flex; align-items: center;
    overflow: hidden; padding: 60px 0 48px;
  }
  .news-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .news-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .news-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(135deg, rgba(11,42,74,0.85) 0%, rgba(11,42,74,0.6) 60%, rgba(11,42,74,0.35) 100%);
  }
  .news-hero-content { position: relative; z-index: 2; max-width: 760px; }
  .news-hero-title { color: #fff; font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; margin: 16px 0 14px; letter-spacing: 0.3px; }
  .news-hero-sub { color: rgba(255,255,255,0.9); font-size: 1rem; line-height: 1.7; margin: 0; }
  .breadcrumb-light a, .breadcrumb-light span { color: rgba(255,255,255,0.85); }
  .breadcrumb-light a:hover { color: #fff; }

  .news-card time { color: var(--blue); font-size: 0.82rem; font-weight: 700; }
  .news-region-chip {
    display: inline-block; background: #fff3e0; color: var(--orange);
    font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; margin-top: 8px;
  }
  .news-card h3 { margin: 8px 0; font-size: 1.05rem; line-height: 1.4; }
  .news-card p { font-size: 0.9rem; line-height: 1.6; color: var(--ink-soft); }
  .read-more { display: inline-block; margin-top: 10px; font-size: 0.88rem; font-weight: 700; color: var(--blue); text-decoration: none; }
  .read-more:hover { color: var(--orange); }
  .region-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .region-chip {
    display: inline-block; background: var(--blue-light); color: var(--navy);
    font-size: 0.88rem; font-weight: 700; padding: 6px 16px; border-radius: 999px;
    margin: 6px; text-decoration: none; transition: all 0.2s;
  }
  .region-chip:hover { background: var(--blue); color: white; }
  @media (max-width: 480px) {
    .news-card h3 { font-size: 0.95rem; }
    .news-card p { font-size: 0.85rem; }
  }
</style>
