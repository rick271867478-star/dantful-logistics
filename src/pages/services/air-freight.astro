---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

const title = 'China Air Freight Forwarder | Dantful';
const description = 'China air freight forwarder. Express, economy and charter air cargo from PVG, CAN, HKG to 200+ global destinations. Daily departures, DDP door-to-door.';
const waNumber = SITE.phone.replace(/[^\d]/g, '');

const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: '/services/' },
    { '@type': 'ListItem', position: 3, name: 'Air Freight', item: '/services/air-freight/' }
  ]
});

const serviceJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'China Air Freight Forwarding',
  serviceType: 'Air Freight Forwarding',
  provider: { '@type': 'Organization', name: SITE.name },
  areaServed: '200+ global destinations',
  description: 'China air freight forwarder offering express, economy and charter air cargo from PVG, CAN, HKG to 200+ global destinations with daily departures and DDP door-to-door delivery.'
});

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does air freight from China take?',
      acceptedAnswer: { '@type': 'Answer', text: 'Air freight from China takes 1 to 3 days on express service (direct flight) and 3 to 7 days on economy service (consolidated). Transit time depends on origin airport (PVG, CAN, HKG, SZX), destination airport, customs clearance, and whether service is direct or consolidated. Door-to-door adds 1 to 2 days for factory pickup and last-mile delivery.' }
    },
    {
      '@type': 'Question',
      name: 'How much does air freight from China cost?',
      acceptedAnswer: { '@type': 'Answer', text: 'Air freight from China starts around [USD X.X per KG] on economy service and [USD X.X per KG] on express. Chargeable weight is the higher of actual gross weight or volumetric weight, where 1 CBM = 167 KG. Rates vary by season (Q4 +30 to 50%), fuel surcharge (FSC), security surcharge (SSC), currency, hazardous goods surcharge, and oversized cargo. Request a quote for a confirmed all-in rate.' }
    },
    {
      '@type': 'Question',
      name: 'What is the difference between express and economy air freight?',
      acceptedAnswer: { '@type': 'Answer', text: 'Express air freight uses a direct flight and takes 1 to 3 days. It costs more but is best for urgent or time-sensitive cargo. Economy air freight consolidates multiple shipments onto one flight via a hub, taking 3 to 7 days. It is cheaper per KG and ideal for shipments over 100 KG with flexible timing. Express is recommended for samples, electronics, and high-value goods. Economy is recommended for cargo over 100 KG that is not time-critical.' }
    },
    {
      '@type': 'Question',
      name: 'Can I ship batteries and electronics by air from China?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, batteries and electronics can ship by air from China with the correct documentation. Lithium-ion and lithium-metal batteries require MSDS, UN38.3 test report, and IATA-compliant packaging. IATA rules include Section IA (large cells over 35 kg), Section IB (medium cells 2.7 to 35 kg), and Section II (small cells under 2.7 kg). State of charge limits (max 30% for standalone lithium-ion batteries), packaging group requirements, and marking/labeling apply. We handle the entire compliance process end-to-end.' }
    },
    {
      '@type': 'Question',
      name: 'What is an Air Waybill (AWB)?',
      acceptedAnswer: { '@type': 'Answer', text: 'An Air Waybill (AWB) is the contract of carriage between the shipper and the airline or forwarder. It serves as a receipt for the cargo and contains shipper/consignee details, flight information, cargo description, and charges. Unlike a Bill of Lading (B/L) for ocean freight, an AWB is not a document of title - cargo is released to the named consignee on arrival without presenting the original. A Master Air Waybill (MAWB) is issued by the airline, and a House Air Waybill (HAWB) is issued by the freight forwarder like Dantful.' }
    }
  ]
});
---

<BaseLayout {title} {description}>
  <section class="route-hero">
    <div class="route-hero-bg">
      <img src="/images/service-air-freight-hero.webp" alt="China air freight forwarder - air cargo terminal at Shanghai Pudong International Airport with cargo planes being loaded" loading="eager" />
    </div>
    <div class="route-hero-overlay"></div>
    <div class="container route-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/services/">Services</a> / <span>Air Freight</span>
      </nav>
      <h1>China Air Freight Forwarder</h1>
      <p class="route-hero-sub">Air freight from China in [3-7 days] from [USD X.X per KG]. Express, economy and charter air cargo from PVG, CAN, HKG to 200+ global destinations. Daily departures, DDP door-to-door delivery.</p>
      <div class="route-hero-cta">
        <a href="/contact/" class="btn btn-primary">Get a Quote</a>
        <a href="#transit" class="btn btn-outline">View Transit Times</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="prose route-overview">
        <p>Dantful Logistics is a licensed air freight forwarder based in Shenzhen since 2008. We hold long-term allotment contracts with Cathay Pacific, China Southern, China Eastern, Air China, Lufthansa Cargo, Emirates SkyCargo and Turkish Cargo. This secures preferential rates and guaranteed block space even during Q4 holiday rush, Apple launch windows and Pre-CNY peak. We move thousands of air shipments every year across Trans-Pacific, Europe, UK, Australia, Canada, Mexico and Intra-Asia lanes.</p>
        <p>This page covers transit times by origin and destination airport, price ranges for express and economy service, the 5-step air freight workflow, the documents you need to prepare, and the questions shippers ask most. <a href="/contact/">Request a quote</a> and you will receive an all-in DDP or airport-to-airport rate within 2 hours.</p>
      </div>

      <h2 class="block-title" id="transit">Transit Times: China to Global Airports</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Origin Airport</th><th>Destination Airport</th><th>Express (days)</th><th>Economy (days)</th><th>Notes</th></tr>
          </thead>
          <tbody>
            <tr><td>PVG (Shanghai)</td><td>LAX/JFK (USA)</td><td>[3-5]</td><td>[5-7]</td><td>Direct flights daily</td></tr>
            <tr><td>CAN (Guangzhou)</td><td>LHR/FRA (Europe)</td><td>[4-6]</td><td>[6-8]</td><td>Via hub</td></tr>
            <tr><td>HKG (Hong Kong)</td><td>SYD/MEL (Australia)</td><td>[5-7]</td><td>[7-9]</td><td>Direct</td></tr>
            <tr><td>SZX (Shenzhen)</td><td>NRT/ICN (Asia)</td><td>[2-4]</td><td>[4-6]</td><td>Short-haul</td></tr>
            <tr><td>PVG</td><td>YYZ/YVR (Canada)</td><td>[4-6]</td><td>[6-8]</td><td>Direct</td></tr>
            <tr><td>HKG</td><td>SIN/KUL (SE Asia)</td><td>[3-5]</td><td>[5-7]</td><td>Intra-Asia</td></tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">Transit times are airport-to-airport. Door-to-door adds 1 to 2 days for factory pickup, export clearance, import clearance and last-mile delivery. Times vary by carrier, season, allotment space and customs. <a href="/contact/">Request a quote</a> for a confirmed flight schedule.</p>

      <h2 class="block-title">Price Range &amp; Cost Factors</h2>
      <div class="prose route-overview">
        <p>Air freight from China is priced per kilogram of chargeable weight. We quote transparent all-in rates with no hidden surcharges.</p>
        <ul>
          <li><strong>Express air:</strong> [USD X.X per KG] 鈥?1-3 days, direct flight. Best for urgent, high-value or time-sensitive cargo.</li>
          <li><strong>Economy air:</strong> [USD X.X per KG] 鈥?3-7 days, consolidated. Best for shipments over 100 KG with flexible timing.</li>
          <li><strong>Air charter:</strong> [USD XXXX per flight] 鈥?for oversized, heavy or time-critical cargo. Whole-plane or part-charter options.</li>
          <li><strong>Air express courier (DHL/UPS/FedEx):</strong> [USD X.X per KG] 鈥?3-6 days for samples under 300 KG. Door-to-door with courier tracking.</li>
          <li><strong>Chargeable weight = max(actual weight, volumetric weight)</strong> where 1 CBM = 167 KG. We calculate both and charge the higher.</li>
        </ul>
        <p><strong>Factors that move your price:</strong></p>
        <ul>
          <li><strong>Season:</strong> Q4 (Sep-Dec), Pre-CNY (Jan-Feb) and Apple launch windows see 30 to 50% rate spikes and tighter allotment space.</li>
          <li><strong>Fuel Surcharge (FSC):</strong> Airlines revise FSC monthly based on jet fuel index. We pass through major shifts with written notice.</li>
          <li><strong>Security Surcharge (SSC):</strong> Applied by airlines for cargo screening and terminal security.</li>
          <li><strong>Currency:</strong> USD quotes avoid currency adjustment. Quotes in other currencies may carry a currency adjustment factor.</li>
          <li><strong>Hazardous goods surcharge:</strong> Lithium batteries, magnets, aerosols and DG cargo carry 10 to 30% surcharge and require DG declaration.</li>
          <li><strong>Oversized cargo:</strong> Cargo exceeding airline dimensional limits (typically over 158cm in any dimension) requires special handling and may incur oversize surcharge.</li>
        </ul>
      </div>

      <h2 class="block-title">5-Step Air Freight Workflow</h2>
      <div class="grid grid-3 step-grid">
        <div class="card step-card">
          <span class="step-num">1</span>
          <h3>Get a Quote</h3>
          <p>Send your origin airport or factory ZIP, destination airport or warehouse ZIP, cargo details, HS code and Incoterm (FOB/EXW/DDP). You receive an all-in rate within 2 hours.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">2</span>
          <h3>Book &amp; Pickup</h3>
          <p>We issue an Air Waybill, book airline block space, and dispatch factory pickup. For EXW terms, we collect from any factory in mainland China within 24 to 48 hours with our own trucking fleet.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">3</span>
          <h3>Export &amp; Document</h3>
          <p>Our licensed customs team handles export declaration, CIQ inspection, and issues CO, FORM A, FORM E, FORM F or RCEP certificates for FTA duty preference at destination.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">4</span>
          <h3>Fly &amp; Track</h3>
          <p>Cargo flies on the booked flight. You receive tracking updates with AWB number, flight number, ETA and customs status. HAWB or MAWB issued per your instruction.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">5</span>
          <h3>Clearance &amp; Delivery</h3>
          <p>We file import customs entry, pay duties on your behalf (DDP terms), and arrange truck delivery to your warehouse, 3PL or Amazon FC. Delivery appointment booked before flight arrival.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">+</span>
          <h3>Sensitive Cargo</h3>
          <p>We handle batteries (MSDS, UN38.3), magnetic goods (magnet test report), cosmetics (CIQ), medical devices (NMPA, CE, FDA). IATA-compliant packaging, marking and documentation. <a href="/contact/">Get a sensitive cargo rate</a>.</p>
        </div>
      </div>

      <h2 class="block-title">Documents You Need to Prepare</h2>
      <div class="prose route-overview">
        <ul class="doc-list">
          <li><strong>Commercial Invoice</strong> 鈥?full seller and buyer details, HS code, unit price, Incoterm, currency, country of origin.</li>
          <li><strong>Packing List</strong> 鈥?carton count, gross weight, net weight, dimensions per carton and total CBM.</li>
          <li><strong>Air Waybill (AWB)</strong> 鈥?we issue a House AWB as forwarder, or use airline Master AWB. Electronic AWB (e-AWB) available on most lanes.</li>
          <li><strong>Certificate of Origin (CO)</strong> 鈥?CCPIT-issued general CO, or FORM A (GSP), FORM E (ASEAN-China), FORM F (Chile), RCEP for FTA duty preference.</li>
          <li><strong>Export Declaration</strong> 鈥?filed by us via EDI with GACC. Requires your business license and foreign exchange registration.</li>
          <li><strong>CIQ Inspection</strong> 鈥?for restricted goods: food, plants, wood, chemicals, batteries, cosmetics. We arrange inspection and issue certificates.</li>
          <li><strong>Restricted goods docs:</strong> MSDS and UN38.3 for lithium batteries, DG packing list and declaration for dangerous goods, magnet test report for magnetic goods, NMPA/CE/FDA for medical devices.</li>
          <li><strong>DG Declaration</strong> 鈥?Shipper's Declaration for Dangerous Goods (IATA Form 4) signed by trained personnel. Required for Class 1-9 dangerous goods.</li>
        </ul>
      </div>

      <h2 class="block-title" id="faq">Frequently Asked Questions</h2>
      <div class="faq-block">
        <h3>How long does air freight from China take?</h3>
        <p>Air freight from China takes 1 to 3 days on express service (direct flight) and 3 to 7 days on economy service (consolidated). Transit time depends on origin airport (PVG Shanghai, CAN Guangzhou, HKG Hong Kong, SZX Shenzhen), destination airport, customs clearance, and whether service is direct or consolidated. Door-to-door adds 1 to 2 days for factory pickup and last-mile delivery. <a href="#transit">See the transit table</a> for airport-by-airport detail.</p>

        <h3>How much does air freight from China cost?</h3>
        <p>Air freight from China starts around [USD X.X per KG] on economy service and [USD X.X per KG] on express. Chargeable weight is the higher of actual gross weight or volumetric weight, where 1 CBM = 167 KG. Rates vary by season (Q4 +30 to 50%), fuel surcharge (FSC), security surcharge (SSC), currency, hazardous goods surcharge, and oversized cargo. We quote transparent all-in rates with no hidden surcharges. <a href="/contact/">Request a quote</a> for a confirmed rate.</p>

        <h3>What is the difference between express and economy air freight?</h3>
        <p>Express air freight uses a direct flight and takes 1 to 3 days. It costs more but is best for urgent or time-sensitive cargo. Economy air freight consolidates multiple shipments onto one flight via a hub, taking 3 to 7 days. It is cheaper per KG and ideal for shipments over 100 KG with flexible timing. Express is recommended for samples, electronics, and high-value goods. Economy is recommended for cargo over 100 KG that is not time-critical.</p>

        <h3>Can I ship batteries and electronics by air from China?</h3>
        <p>Yes, batteries and electronics can ship by air from China with the correct documentation. Lithium-ion and lithium-metal batteries require MSDS, UN38.3 test report, and IATA-compliant packaging. IATA rules include Section IA (large cells over 35 kg), Section IB (medium cells 2.7 to 35 kg), and Section II (small cells under 2.7 kg). State of charge limits (max 30% for standalone lithium-ion batteries), packaging group requirements, and marking/labeling apply. We handle the entire compliance process end-to-end.</p>

        <h3>What is an Air Waybill (AWB)?</h3>
        <p>An Air Waybill (AWB) is the contract of carriage between the shipper and the airline or forwarder. It serves as a receipt for the cargo and contains shipper/consignee details, flight information, cargo description, and charges. Unlike a Bill of Lading (B/L) for ocean freight, an AWB is not a document of title - cargo is released to the named consignee on arrival without presenting the original. A Master Air Waybill (MAWB) is issued by the airline, and a House Air Waybill (HAWB) is issued by the freight forwarder like Dantful. <a href="/services/customs-clearance/">See our customs clearance service</a>.</p>
      </div>

      <h2 class="block-title">Related Routes &amp; Services</h2>
      <div class="grid grid-3 chip-row">
        <a href="/services/ocean-freight/" class="card svc-card">
          <h3>Ocean Freight</h3>
          <p>FCL 20GP/40HQ and LCL consolidation to USA, EU, UK, Australia, Canada. Direct carrier contracts, weekly sailings, DDP clearance.</p>
        </a>
        <a href="/services/customs-clearance/" class="card svc-card">
          <h3>Customs Clearance</h3>
          <p>Class-A licensed brokerage. ISF, AMS, ENS, CO, FORM A/E, HS classification and FTA duty optimization.</p>
        </a>
        <a href="/fba/china-to-usa/" class="card svc-card">
          <h3>Amazon FBA</h3>
          <p>FBA prep, labeling and delivery to Amazon FCs in USA, EU, UK, JP, AU. DDP clearance and appointment booking.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-row">
      <div class="cta-text">
        <h2>Get an All-In Rate for Your Air Freight from China</h2>
        <p>Send your cargo details, origin and destination. You receive a confirmed all-in express, economy or DDP rate within 2 hours.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact/" class="btn btn-primary">Get a Quote</a>
        <a href={`https://wa.me/${waNumber}`} class="btn btn-whatsapp" target="_blank" rel="noopener">WhatsApp Us</a>
        <a href={`mailto:${SITE.email}`} class="btn btn-outline">{SITE.email}</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script type="application/ld+json" set:html={serviceJsonLd} />
  <script type="application/ld+json" set:html={faqJsonLd} />

  <style>
    .route-hero { position: relative; min-height: 540px; display: flex; align-items: center; color: #fff; overflow: hidden; }
    .route-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
    .route-hero-bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .route-hero-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(8, 30, 64, 0.82) 0%, rgba(12, 50, 110, 0.7) 100%); }
    .route-hero-content { position: relative; z-index: 2; padding: 80px 24px; max-width: 960px; }
    .breadcrumb { font-size: 14px; margin-bottom: 16px; }
    .breadcrumb-light a { color: #d9e6ff; text-decoration: none; }
    .breadcrumb-light a:hover { text-decoration: underline; }
    .breadcrumb-light span { color: #fff; }
    .route-hero h1 { font-size: 40px; line-height: 1.2; margin: 0 0 16px; font-weight: 700; }
    .route-hero-sub { font-size: 18px; line-height: 1.55; max-width: 820px; margin: 0 0 28px; }
    .route-hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn { display: inline-block; padding: 12px 24px; border-radius: 4px; font-weight: 600; font-size: 15px; text-decoration: none; transition: background 0.2s, color 0.2s, border 0.2s; }
    .btn-primary { background: #ff6b35; color: #fff; }
    .btn-primary:hover { background: #e55a2a; }
    .btn-outline { background: transparent; color: #fff; border: 2px solid #fff; }
    .btn-outline:hover { background: #fff; color: #0c326e; }
    .btn-whatsapp { background: #25d366; color: #fff; }
    .btn-whatsapp:hover { background: #1ebe5a; }
    .block-title { font-size: 26px; margin: 36px 0 16px; color: #0c326e; font-weight: 700; }
    .route-overview { font-size: 16px; line-height: 1.7; color: #2c3e50; margin: 16px 0 24px; }
    .route-overview p { margin: 0 0 14px; }
    .route-overview ul { padding-left: 22px; margin: 8px 0 16px; }
    .route-overview li { margin: 6px 0; }
    .route-overview a { color: #0c5fa8; }
    .table-wrap { overflow-x: auto; margin: 16px 0 8px; }
    .table-wrap table { border-collapse: collapse; width: 100%; font-size: 14px; min-width: 640px; }
    .table-wrap th, .table-wrap td { border: 1px solid #e0e6ed; padding: 10px 12px; text-align: left; }
    .table-wrap th { background: #0c326e; color: #fff; font-weight: 600; }
    .table-wrap tbody tr:nth-child(even) { background: #f6f8fb; }
    .table-note { font-size: 13px; color: #5a6b7c; margin: 0 0 20px; }
    .step-grid { gap: 16px; margin: 16px 0 24px; }
    .step-card { position: relative; padding: 28px 20px 20px; border: 1px solid #e0e6ed; border-radius: 8px; background: #fff; }
    .step-card .step-num { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: #ff6b35; color: #fff; font-weight: 700; font-size: 18px; margin-bottom: 12px; }
    .step-card h3 { margin: 0 0 8px; color: #0c326e; font-size: 18px; }
    .step-card p { margin: 0; font-size: 14px; line-height: 1.6; color: #2c3e50; }
    .step-card a { color: #0c5fa8; }
    .doc-list { list-style: none; padding: 0; margin: 12px 0 24px; }
    .doc-list li { padding: 10px 14px 10px 32px; margin: 6px 0; border-left: 3px solid #ff6b35; background: #f6f8fb; position: relative; }
    .doc-list li::before { content: "OK"; position: absolute; left: 10px; top: 10px; font-size: 12px; color: #25a04a; font-weight: 700; }
    .faq-block { margin: 16px 0 24px; }
    .faq-block h3 { font-size: 17px; color: #0c326e; margin: 20px 0 8px; cursor: pointer; }
    .faq-block p { font-size: 15px; line-height: 1.7; color: #2c3e50; margin: 0 0 12px; padding-left: 16px; border-left: 3px solid #e0e6ed; }
    .faq-block a { color: #0c5fa8; }
    .chip-row { gap: 16px; margin: 16px 0 24px; }
    .svc-card { padding: 22px 20px; border: 1px solid #e0e6ed; border-radius: 8px; background: #fff; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; }
    .svc-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(12, 50, 110, 0.12); }
    .svc-card h3 { margin: 0 0 8px; color: #0c326e; font-size: 17px; }
    .svc-card p { margin: 0; font-size: 14px; line-height: 1.6; color: #2c3e50; }
    .cta-section { background: #0c326e; color: #fff; padding: 56px 0; margin-top: 40px; }
    .cta-row { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
    .cta-text h2 { margin: 0 0 8px; font-size: 24px; color: #fff; }
    .cta-text p { margin: 0; color: #d9e6ff; }
    .cta-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    .grid { display: grid; }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    .card { background: #fff; border-radius: 8px; }
    @media (max-width: 900px) {
      .grid-3 { grid-template-columns: 1fr; }
      .route-hero { min-height: 420px; }
      .route-hero h1 { font-size: 30px; }
      .route-hero-sub { font-size: 16px; }
      .cta-row { flex-direction: column; align-items: flex-start; }
    }
  </style>
</BaseLayout>