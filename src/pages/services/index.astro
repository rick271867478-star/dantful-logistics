---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
---

<BaseLayout
  title="Freight Services from China | Ocean & Air"
  description="Freight forwarding services from China: ocean freight (FCL/LCL), air freight, Amazon FBA, customs clearance, warehousing and DDP door-to-door shipping."
>
  <section class="svc-hero">
    <div class="svc-hero-bg">
      <img src="/images/services-hero.jpg" alt="Freight forwarding services from China - ocean, air, warehousing and customs" loading="eager" />
    </div>
    <div class="svc-hero-overlay"></div>
    <div class="container svc-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Services</span>
      </nav>
      <h1 class="svc-hero-title">OUR SERVICES</h1>
      <p class="svc-hero-sub">Full-range freight forwarding and logistics services from China -- ocean freight FCL and LCL, air freight, Amazon FBA shipping, licensed customs clearance, bonded warehousing and complete door-to-door DDP solutions for shipments to 120+ countries worldwide.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="grid grid-3">
        {services.map((s) => (
          <div class="card svc-card-new">
            <div class="svc-card-img">
              <img src={`/images/service-${s.slug}.webp`} alt={`${s.title} service from China`} loading="lazy" />
            </div>
            <div class="svc-card-body">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
              </div>
              <h3><a href={`/services/${s.slug}/`} class="svc-link">{s.title}</a></h3>
              <p>{s.short}</p>
              <ul class="chips">
                {s.highlights.map((h) => <li>{h}</li>)}
              </ul>
              <a class="btn btn-outline" href={`/services/${s.slug}/`}>View Details</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-hero {
    position: relative; min-height: 300px; display: flex; align-items: center;
    overflow: hidden; padding: 60px 0 48px;
  }
  .svc-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .svc-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .svc-hero-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(135deg, rgba(11,42,74,0.85) 0%, rgba(11,42,74,0.6) 60%, rgba(11,42,74,0.35) 100%);
  }
  .svc-hero-content { position: relative; z-index: 2; max-width: 760px; }
  .svc-hero-title { color: #fff; font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; margin: 16px 0 14px; letter-spacing: 0.3px; }
  .svc-hero-sub { color: rgba(255,255,255,0.9); font-size: 1rem; line-height: 1.7; margin: 0; }
  .breadcrumb-light a, .breadcrumb-light span { color: rgba(255,255,255,0.85); }
  .breadcrumb-light a:hover { color: #fff; }

  .svc-card-new { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .svc-card-img { height: 160px; overflow: hidden; }
  .svc-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .svc-card-new:hover .svc-card-img img { transform: scale(1.05); }
  .svc-card-body { padding: 22px 20px; }

  .svc-link { color: inherit; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 20px; padding: 0; }
  .chips li {
    background: var(--blue-light); color: var(--navy-2);
    font-size: 0.78rem; font-weight: 600; padding: 4px 12px; border-radius: 999px;
  }
  .card .btn-outline { display: inline-flex; min-height: 44px; touch-action: manipulation; }
  @media (max-width: 480px) {
    .chips li { font-size: 0.72rem; padding: 3px 10px; }
  }
</style>
