---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

const title = 'Ocean Freight Forwarding from China | Dantful';
const description = 'Ocean freight forwarding from China. FCL 20GP/40HQ and LCL consolidation, container shipping from China to USA, EU, UK, Australia, Canada. Direct carrier contracts, weekly sailings, DDP clearance.';
const waNumber = SITE.phone.replace(/[^\d]/g, '');

const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: '/services/' },
    { '@type': 'ListItem', position: 3, name: 'Ocean Freight', item: '/services/ocean-freight/' }
  ]
});

const serviceJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Ocean Freight Forwarding from China',
  serviceType: 'Ocean Freight Forwarding',
  provider: { '@type': 'Organization', name: SITE.name },
  areaServed: ['United States', 'European Union', 'United Kingdom', 'Australia', 'Canada', 'Southeast Asia'],
  description: 'Ocean freight forwarding from China with FCL, LCL consolidation, direct carrier contracts and DDP clearance to global ports.'
});

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long are shipping containers?',
      acceptedAnswer: { '@type': 'Answer', text: 'Shipping containers come in two primary lengths: 20 feet and 40 feet. A 20ft standard container (20GP) is 19 ft 10-1/2 in internal length, 7 ft 8-1/8 in width, 7 ft 10-5/8 in height, with 33.2 CBM volume. A 40ft standard (40GP) is 39 ft 5-3/8 in internal length, same width and height, 67.6 CBM. The 40ft High Cube adds 1 foot of height for 76.3 CBM.' }
    },
    {
      '@type': 'Question',
      name: 'What size are shipping containers?',
      acceptedAnswer: { '@type': 'Answer', text: 'Standard shipping container sizes: 20GP (20 ft x 8 ft x 8 ft 6 in, 33.2 CBM), 40GP (40 ft x 8 ft x 8 ft 6 in, 67.6 CBM), 40HQ High Cube (40 ft x 8 ft x 9 ft 6 in, 76.3 CBM). Also available: 45HQ, 20RF/40RF reefer, 20OT open top, 40FR flat rack.' }
    },
    {
      '@type': 'Question',
      name: 'What is the volume of a 40ft container?',
      acceptedAnswer: { '@type': 'Answer', text: 'A 40ft standard dry van has 67.6 CBM (2,389 cu ft) internal volume. The 40ft High Cube has 76.3 CBM (2,694 cu ft). Maximum gross weight is 30,480 KG for both.' }
    },
    {
      '@type': 'Question',
      name: 'How long does sea freight from China take?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sea freight from China to US West Coast takes 14 to 20 days. To US East Coast 26 to 32 days. To Europe 30 to 38 days. To UK 28 to 35 days. To Australia 18 to 24 days. To Southeast Asia 7 to 12 days. Door-to-door adds 4 to 7 days.' }
    },
    {
      '@type': 'Question',
      name: 'What is the difference between FCL and LCL shipping?',
      acceptedAnswer: { '@type': 'Answer', text: 'FCL (Full Container Load) means your cargo fills a 20GP, 40GP or 40HQ container — pay per container. LCL (Less than Container Load) means your cargo shares a container — pay per CBM. LCL is cheaper under 15 CBM; FCL is cheaper over 15 CBM.' }
    },
    {
      '@type': 'Question',
      name: 'How much does ocean freight from China cost?',
      acceptedAnswer: { '@type': 'Answer', text: 'A 40HQ from Shenzhen to Los Angeles starts from USD 2,000 per 40HQ low season. LCL starts from USD 2.5 per CBM. Rates rise 30 to 60% in Q4 and Pre-CNY peaks.' }
    },
    {
      '@type': 'Question',
      name: 'What are demurrage and detention fees?',
      acceptedAnswer: { '@type': 'Answer', text: 'Demurrage and detention fees are carrier charges for holding containers beyond free time. Demurrage applies at destination port after discharge; detention applies when the empty container is with the shipper. Typical free time: 5-7 days destination, 10 days export.' }
    },
    {
      '@type': 'Question',
      name: 'What is a House Bill of Lading?',
      acceptedAnswer: { '@type': 'Answer', text: 'A House Bill of Lading (HBL) is issued by an NVOCC freight forwarder to the shipper. It is a receipt for cargo, evidence of carriage contract, and document of title. The Master B/L is issued by the carrier to the NVOCC.' }
    }
  ]
});
---

<BaseLayout {title} {description}>
  <section class="route-hero">
    <div class="route-hero-bg">
      <img src="/images/service-ocean-freight-hero.webp" alt="Ocean freight forwarding from China - container terminal at Shanghai Yangshan port with FCL and LCL shipping" loading="eager" />
    </div>
    <div class="route-hero-overlay"></div>
    <div class="container route-hero-content">
      <nav class="breadcrumb breadcrumb-light" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/services/">Services</a> / <span>Ocean Freight</span>
      </nav>
      <h1>Ocean Freight Forwarding from China</h1>
      <p class="route-hero-sub">FCL 20GP/40HQ and LCL consolidation from Shenzhen, Shanghai, Ningbo, Guangzhou, Qingdao and Hong Kong to USA, EU, UK, Australia, Canada and Southeast Asia. Your partner for container shipping from China with direct carrier contracts, weekly sailings, guaranteed peak-season space, DDP clearance from USD 2,000 per 40HQ.</p>
      <div class="route-hero-cta">
        <a href="/contact/" class="btn btn-primary">Get a Quote</a>
        <a href="#transit" class="btn btn-outline">View Transit Times</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="prose route-overview">
        <p>Dantful Logistics is a licensed NVOCC (Non-Vessel Operating Common Carrier) based in Shenzhen since 2008. We hold long-term direct contracts with Maersk, MSC, COSCO, ONE, Evergreen, CMA CGM and Hapag-Lloyd. This secures preferential rates and guaranteed container space even during Pre-CNY, Amazon Prime Day and Q4 holiday rush windows. We move thousands of containers every year across Trans-Pacific, North Europe, Mediterranean, UK, Australia, Canada, Mexico and Latin America lanes.</p>
        <p>This page covers transit times by destination region, price ranges for FCL and LCL, the 5-step ocean freight workflow, the documents you need to prepare, and the questions shippers ask most. <a href="/contact/">Request a quote</a> and you will receive an all-in DDP or FOB rate within 2 hours.</p>
      </div>

      <h2 class="block-title" id="transit">Transit Times: China to Global Ports</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Origin Port</th><th>Destination Region</th><th>Sea FCL (days)</th><th>Door-to-Door (days)</th><th>Notes</th></tr>
          </thead>
          <tbody>
            <tr><td>Shenzhen (Yantian)</td><td>USA West Coast (LAX, LGB)</td><td>14-20</td><td>18-24</td><td>Direct, weekly</td></tr>
            <tr><td>Shanghai (Yangshan)</td><td>USA East Coast (NYC, SAV)</td><td>26-32</td><td>35-42</td><td>Via Panama Canal</td></tr>
            <tr><td>Ningbo</td><td>Europe (Rotterdam, Hamburg)</td><td>30-38</td><td>38-46</td><td>Asia-North Europe loop</td></tr>
            <tr><td>Guangzhou (Nansha)</td><td>UK (Felixstowe, Tilbury)</td><td>28-35</td><td>32-40</td><td>Direct, weekly</td></tr>
            <tr><td>Qingdao</td><td>Australia (Sydney, Melbourne)</td><td>20-28</td><td>22-30</td><td>Trans-Pacific direct</td></tr>
            <tr><td>Hong Kong (HKG)</td><td>Canada (Vancouver, Prince Rupert)</td><td>16-22</td><td>20-28</td><td>Direct, weekly</td></tr>
            <tr><td>Shenzhen (Yantian)</td><td>Southeast Asia (Singapore, Port Klang)</td><td>7-12</td><td>10-16</td><td>Intra-Asia feeder</td></tr>
            <tr><td>Shanghai (Yangshan)</td><td>Mediterranean (Genoa, Barcelona)</td><td>32-40</td><td>36-44</td><td>Via Suez Canal</td></tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">Transit times are port-to-port and door-to-door including export clearance, ocean carriage, import clearance and inland delivery. Times vary by carrier, season, port congestion and canal transit. <a href="/contact/">Request a quote</a> for a confirmed sailing schedule.</p>

      <h2 class="block-title">Price Range &amp; Cost Factors</h2>
      <div class="prose route-overview">
        <p>Ocean freight from China is priced per container (FCL) or per CBM (LCL). We quote transparent all-in rates with no hidden surcharges.</p>
        <ul>
          <li><strong>FCL 20GP:</strong> from USD 2,000 per container 鈥?best for 28-30 CBM shipments.</li>
          <li><strong>FCL 40HQ:</strong> from USD 2,000 per container 鈥?best for 65-76 CBM shipments, lowest per-CBM cost.</li>
          <li><strong>LCL consolidation:</strong> from USD 2.5 per CBM 鈥?best for shipments under 15 CBM, minimum 1 CBM, weekly from Shenzhen, Shanghai and Ningbo.</li>
          <li><strong>OOG / project cargo:</strong> flat-rack, open-top or ISO-tank solutions. <a href="/contact/">Request a quote</a> for custom pricing.</li>
          <li><strong>Reefer container:</strong> for temperature-controlled cargo. Starts around from USD 3,500 per 40HQ reefer.</li>
        </ul>
        <p><strong>Factors that move your price:</strong></p>
        <ul>
          <li><strong>Season:</strong> Pre-CNY (Jan-Feb), Prime Day (Jul), Black Friday and Q4 (Sep-Dec) see 30 to 60% rate spikes and tighter container space.</li>
          <li><strong>Bunker Adjustment Factor (BAF):</strong> Carriers revise fuel surcharges quarterly. We absorb minor changes; major shifts pass through with written notice.</li>
          <li><strong>Peak Season Surcharge (PSS):</strong> Applied by carriers from June to October on major lanes.</li>
          <li><strong>Currency Adjustment Factor (CAF):</strong> Applied to USD quotes paid in other currencies. We quote in USD to avoid CAF.</li>
          <li><strong>Port congestion:</strong> LAX/LGB, NYC/NJ, Rotterdam, Felixstowe and Sydney experience periodic congestion. We offer alternative ports to keep your cargo moving.</li>
          <li><strong>Canal transit:</strong> Panama (Americas East Coast), Suez (Europe, Mediterranean). Delays or route changes impact transit time and cost.</li>
          <li><strong>Container type:</strong> General purpose (GP), High Cube (HQ), Reefer (RF), Open Top (OT), Flat Rack (FR), ISO Tank (TK). Special equipment costs 15 to 40% more.</li>
        </ul>
      </div>

      <h2 class="block-title">5-Step Ocean Freight Workflow</h2>
      <div class="grid grid-3 step-grid">
        <div class="card step-card">
          <span class="step-num">1</span>
          <h3>Get a Quote</h3>
          <p>Send your origin port or factory ZIP, destination port or warehouse ZIP, cargo details, HS code and Incoterm (FOB/EXW/CIF/DDP). You receive an all-in rate within 2 hours.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">2</span>
          <h3>Book &amp; Pickup</h3>
          <p>We issue a shipping order, book vessel space, and dispatch factory pickup. For EXW terms, we collect from any factory in mainland China within 24 to 48 hours with our own trucking fleet.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">3</span>
          <h3>Export &amp; Document</h3>
          <p>Our licensed customs team handles export declaration, CIQ inspection, and issues CO, FORM A, FORM E, FORM F or RCEP certificates to claim FTA duty preference at destination.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">4</span>
          <h3>Sail &amp; Track</h3>
          <p>Container sails on the booked vessel. You receive weekly tracking emails with carrier link, ETA, vessel name and customs status. Telex release or original B/L issued per your instruction.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">5</span>
          <h3>Clearance &amp; Delivery</h3>
          <p>We file import customs entry, pay duties on your behalf (DDP terms), and arrange truck or rail delivery to your warehouse, 3PL or Amazon FC. Delivery appointment booked before vessel arrival.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">+</span>
          <h3>LCL Consolidation</h3>
          <p>For shipments under 15 CBM, our weekly LCL hubs in Shenzhen, Shanghai and Guangzhou combine multiple supplier cargo into single containers. This cuts per-CBM cost by 30 to 60% versus FCL. <a href="/contact/">Get an LCL rate</a>.</p>
        </div>
      </div>

      <h2 class="block-title">Documents You Need to Prepare</h2>
      <div class="prose route-overview">
        <ul class="doc-list">
          <li><strong>Commercial Invoice</strong> 鈥?full seller and buyer details, HS code, unit price, Incoterm, currency, country of origin.</li>
          <li><strong>Packing List</strong> 鈥?carton count, gross weight, net weight, dimensions per carton and total CBM.</li>
          <li><strong>Bill of Lading (B/L)</strong> 鈥?we issue a House B/L as NVOCC, or use carrier Master B/L. Original, telex release or Sea Waybill available.</li>
          <li><strong>Certificate of Origin (CO)</strong> 鈥?CCPIT-issued general CO, or FORM A (GSP), FORM E (ASEAN-China), FORM F (Chile), RCEP for FTA duty preference.</li>
          <li><strong>Export Declaration</strong> 鈥?filed by us via EDI with GACC. Requires your business license and foreign exchange registration.</li>
          <li><strong>CIQ Inspection</strong> 鈥?for restricted goods: food, plants, wood, chemicals, batteries. We arrange inspection and issue certificates.</li>
          <li><strong>Restricted goods docs:</strong> MSDS and UN38.3 for lithium batteries, DG packing list for dangerous goods, phytosanitary certificate for wood packaging (ISPM-15).</li>
          <li><strong>Marine cargo insurance</strong> 鈥?optional. All-risk coverage at 0.3 to 0.5% of declared value. Recommended for high-value or fragile cargo.</li>
        </ul>
      </div>

      <h2 class="block-title" id="container-sizes">Container Sizes Chart: How Big is a Shipping Container?</h2>
      <p style="font-size:15px;color:#5a6b7c;margin:-4px 0 12px;">Exact 20ft and 40ft container dimensions, internal measurements, volume and max gross weight — your complete sea can size reference.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Container Type</th><th>External L × W × H (ft)</th><th>Internal L × W × H (ft)</th><th>Volume (CBM)</th><th>Max Gross Wt (KG)</th><th>Best For</th></tr>
          </thead>
          <tbody>
            <tr><td>20GP Standard</td><td>20' × 8' × 8' 6"</td><td>19' 4-1/2" × 7' 8-1/8" × 7' 10-5/8"</td><td>33.2</td><td>28,000</td><td>Smaller shipments, dense cargo</td></tr>
            <tr><td>40GP Standard</td><td>40' × 8' × 8' 6"</td><td>39' 5-3/8" × 7' 8-1/8" × 7' 10-5/8"</td><td>67.6</td><td>30,480</td><td>Most general cargo</td></tr>
            <tr><td>40HQ High Cube</td><td>40' × 8' × 9' 6"</td><td>39' 5-3/8" × 7' 8-1/8" × 8' 10-5/16"</td><td>76.3</td><td>30,480</td><td>Bulky light cargo, pallet stacks</td></tr>
            <tr><td>45HQ High Cube</td><td>45' × 8' × 9' 6"</td><td>44' 6" × 7' 8-1/8" × 8' 10-5/16"</td><td>86.0</td><td>30,480</td><td>Extended-length cargo</td></tr>
            <tr><td>20RF Reefer</td><td>20' × 8' × 8' 6"</td><td>18' 11-3/4" × 7' 6-1/8" × 7' 5-7/8"</td><td>28.3</td><td>26,000</td><td>Temperature-controlled cargo</td></tr>
            <tr><td>40RF Reefer HC</td><td>40' × 8' × 9' 6"</td><td>38' 0-1/8" × 7' 4-5/8" × 8' 6-1/4"</td><td>67.0</td><td>30,000</td><td>Perishables, pharmaceuticals</td></tr>
            <tr><td>20OT Open Top</td><td>20' × 8' × 8' 6"</td><td>19' 4-1/2" × 7' 8-1/8" × 7' 10-5/8"</td><td>32.4</td><td>28,000</td><td>Over-height cargo (steel, pipes)</td></tr>
            <tr><td>40FR Flat Rack</td><td>40' × 8' × 8' 6"</td><td>39' 6" × 7' 10-1/4" (no sides)</td><td>—</td><td>35,000</td><td>Oversized project cargo</td></tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">All dimensions are nominal. Actual measurements vary slightly by manufacturer and container age. TEU = Twenty-foot Equivalent Unit; a 40ft container counts as 2 TEU. All our rates include the container type appropriate for your cargo. <a href="/contact/">Tell us what you're shipping</a> and we recommend the right sea can size.</p>

      <h2 class="block-title" id="faq">Frequently Asked Questions</h2>
      <div class="faq-block">
        <h3>How long are shipping containers? What size are they?</h3>
        <p>The most common ocean container sizes are 20 feet and 40 feet in length. A 20 ft standard shipping container (20GP) is exactly 6.058m (19' 10-1/2") long, 2.438m (8') wide, and 2.591m (8' 6") tall — that's approximately 1,172 cubic feet (33.2 CBM) inside. A 40 ft standard container (40GP) doubles the length to 12.192m (40'), with internal dimensions of 40' × 8' × 8' 6" and 2,389 cubic feet (67.6 CBM). The popular 40 foot high cube (40HQ) adds one foot of height (9' 6" / 2.896m) for 2,694 cubic feet (76.3 CBM) — ideal for bulky but light cargo. See our <a href="#container-sizes">container sizes chart</a> below for exact internal and external measurements of all sea can types including 20ft container dimensions, 40ft container dims, and 40' container internal dimensions.</p>

        <h3>What is the volume of a 40ft container?</h3>
        <p>A standard 40ft dry van has a shipping container volume of approximately 67.6 cubic meters (2,389 cubic feet). The 40ft High Cube (40HQ) has a volume of about 76.3 CBM (2,694 cu ft). Maximum gross weight is 30,480 KG for both 40GP and 40HQ. A 20ft container holds about 33.2 CBM (1,172 cu ft) with a 28,000 KG max gross weight. We recommend 40HQ over 40GP whenever you need more height for pallets or overstacked cartons.</p>

        <h3>How long does sea freight from China take?</h3>
        <p>Sea freight from China to US West Coast (Los Angeles, Long Beach) takes 18 to 25 days port-to-port. To US East Coast (New York, Savannah) 26 to 32 days. To Europe (Rotterdam, Hamburg) 30 to 38 days. To UK (Felixstowe) 28 to 35 days. To Australia (Sydney) 18 to 24 days. To Southeast Asia (Singapore) 7 to 12 days. Door-to-door adds 4 to 7 days for customs and inland delivery. <a href="#transit">See the transit table</a> for port-by-port detail.</p>

        <h3>What is the difference between FCL and LCL shipping?</h3>
        <p>FCL (Full Container Load) means your cargo fills a 20GP, 40GP or 40HQ container. You pay a flat rate per container regardless of how full it is. LCL (Less than Container Load) means your cargo shares a container with other shipments. You pay per CBM. LCL is cheaper for shipments under 15 CBM. FCL is cheaper for shipments over 15 CBM and offers faster transit, as there is no consolidation or deconsolidation delay.</p>

        <h3>How much does ocean freight from China cost?</h3>
        <p>A 40HQ container from Shenzhen Yantian to Los Angeles starts around from USD 2,000 per 40HQ in low season, rising 30 to 60% during Q4 peak. LCL consolidation starts around from USD 2.5 per CBM with a 1 CBM minimum. Rates vary by destination, season, carrier, BAF and PSS. We quote transparent all-in rates with no hidden surcharges. <a href="/contact/">Request a quote</a> for a confirmed rate.</p>

        <h3>What is a House Bill of Lading (HBL)?</h3>
        <p>A House Bill of Lading (HBL) is issued by an NVOCC freight forwarder like Dantful to the shipper. It serves as a receipt for cargo, evidence of the contract of carriage, and a document of title. The Master Bill of Lading (MBL) is issued by the carrier (Maersk, MSC, etc.) to the NVOCC. The HBL is what you use to claim your cargo at destination. As a licensed NVOCC, we issue HBLs with telex release (electronic) or original paper B/L options. <a href="/services/customs-clearance/">See our customs clearance service</a>.</p>

        <h3>Do I need cargo insurance for ocean freight from China?</h3>
        <p>Cargo insurance is optional but recommended. Carrier liability is limited under the Hague-Visby Rules to 2 SDR per kg or 666.67 SDR per package, whichever is lower. This means a USD 50,000 shipment insured by the carrier may only recover around USD 1,000 if lost. We offer all-risk cargo insurance at 0.3 to 0.5% of declared value with immediate claim support.</p>

        <h3>What are demurrage and detention fees?</h3>
        <p>Demurrage and detention fees are carrier charges for holding containers beyond the free time allowance. Demurrage applies when the loaded container is held at the destination port after discharge (import side) or when an empty container is held past the return deadline (export side). Detention applies when the empty container is with the shipper/trucker outside the port. Typical free time is 5 to 7 days at destination and 10 days on the export side. Rates vary by carrier, port and container type. As your sea freight broker, we monitor free time windows and alert you 48 hours before expiry to avoid demurrage cost. We also negotiate extended free time with carriers for regular customers.</p>
      </div>

      <h2 class="block-title">Related Routes &amp; Services</h2>
      <div class="grid grid-3 chip-row">
        <a href="/routes/china-to-usa/" class="card svc-card">
          <h3>China to USA</h3>
          <p>Trans-Pacific FCL and LCL to Los Angeles, Long Beach, New York and Savannah. DDP clearance and Amazon FBA delivery.</p>
        </a>
        <a href="/routes/china-to-uk/" class="card svc-card">
          <h3>China to UK</h3>
          <p>FCL and LCL to Felixstowe and Tilbury. DDP clearance with VAT and duty included.</p>
        </a>
