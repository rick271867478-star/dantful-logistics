---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
---

<BaseLayout title={`${service.title} from China`} description={service.description}>
  <section>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/services/">Services</a> / <span>{service.title}</span>
      </nav>

      <div class="svc-head">
        <div>
          <h1 class="section-title" style="text-align:left">{service.title}</h1>
          <p class="section-sub" style="margin-inline:0">{service.short}</p>
          <a href="/contact/" class="btn btn-primary">Get a Quote</a>
        </div>
        <img src={`/images/service-${service.slug}.webp`} alt={`${service.title} service from China - professional freight shipping`} class="svc-head-img" loading="lazy" />
      </div>

      <div class="grid grid-4" style="margin-bottom: 48px">
        {service.highlights.map((h) => (
          <div class="card"><h2 style="font-size: 0.98rem">{h}</h2></div>
        ))}
      </div>

      <div class="prose" style="max-width: 760px">
        {service.body.map((para) => <p>{para}</p>)}
        <!-- TODO【SEO 加分】：后续补 FAQ（配 FAQPage 结构化数据）和真实案例 -->
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2 class="section-title">Other Services</h2>
      <div class="grid grid-3">
        {services.filter((s) => s.slug !== service.slug).map((s) => (
          <a class="card svc-card" href={`/services/${s.slug}/`}>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; }
  .svc-head-img { display: block; width: 100%; height: 240px; object-fit: cover; border-radius: 12px; }
  .svc-card { color: inherit; text-decoration: none !important; }
  @media (max-width: 820px) { .svc-head { grid-template-columns: 1fr; } }
</style>
