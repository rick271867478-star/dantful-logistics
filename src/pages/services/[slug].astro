---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: '/services/' },
    { '@type': 'ListItem', position: 3, name: service.title, item: `/services/${service.slug}/` }
  ]
});

const serviceJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  provider: { '@type': 'Organization', name: SITE.name },
  description: service.description
});

const faqJsonLd = service.faq
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: service.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    })
  : null;
---

<BaseLayout title={`${service.title} from China`} description={service.description}>
  <section>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/services/">Services</a> / <span>{service.title}</span>
      </nav>

      <div class="svc-head">
        <div>
          <h1 class="section-title" style="text-align:left">{service.title}</h1>
          <p class="section-sub" style="margin-inline:0">{service.short}</p>
          <a href="/contact/" class="btn btn-primary">Get a Quote</a>
        </div>
        <img src={`/images/service-${service.slug}.webp`} alt={`${service.title} service from China - professional freight shipping`} class="svc-head-img" loading="lazy" />
      </div>

      <div class="grid grid-4" style="margin-bottom: 48px">
        {service.highlights.map((h) => (
          <div class="card"><h2 style="font-size: 0.98rem">{h}</h2></div>
        ))}
      </div>

      <div class="prose" style="max-width: 760px">
        {service.body.map((para) => <p>{para}</p>)}
      </div>

      {service.faq && (
        <div style="max-width: 760px; margin-top: 48px">
          <h2 class="section-title" style="text-align:left">Frequently Asked Questions</h2>
          <div class="faq-list">
            {service.faq.map((f) => (
              <div class="faq-item">
                <h3>{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2 class="section-title">Other Services</h2>
      <div class="grid grid-3">
        {services.filter((s) => s.slug !== service.slug).map((s) => (
          <a class="card svc-card" href={`/services/${s.slug}/`}>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script type="application/ld+json" set:html={serviceJsonLd} />
  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}
</BaseLayout>

<style>
  .svc-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; }
  .svc-head-img { display: block; width: 100%; height: 240px; object-fit: cover; border-radius: 12px; }
  .svc-card { color: inherit; text-decoration: none !important; }
  .faq-list { display: flex; flex-direction: column; gap: 16px; margin-top: 20px; }
  .faq-item { border: 1px solid var(--line); border-radius: 12px; padding: 20px 22px; background: #fff; }
  .faq-item h3 { font-size: 1.02rem; color: var(--navy); margin: 0 0 8px; }
  .faq-item p { color: var(--ink-soft); line-height: 1.7; margin: 0; }
  @media (max-width: 820px) { .svc-head { grid-template-columns: 1fr; } }
</style>
