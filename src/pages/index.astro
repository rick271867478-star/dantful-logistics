---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { services } from '../data/services';

/* 六个优势（需求文档板块 3）：小图标 + 标题 + SEO 长文案 */
const advantages = [
  {
    icon: 'M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6',
    title: 'Competitive Rates',
    text:
      'We hold direct contracts with Maersk, MSC, COSCO, Air China, Cathay Pacific and 40+ global carriers. This locks in preferential all-in FCL, LCL and air freight rates. Our weekly LCL consolidation hubs in Shenzhen, Shanghai and Guangzhou cut landed cost by 15 to 35 percent. No hidden fuel surcharges or peak-season GRI markup.',
  },
  {
    icon: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
    title: 'Fast Response',
    text:
      'Get a detailed ocean or air freight quote within 2 working hours during China business hours. Even on weekends, CNY or Golden Week, we reply within 12 hours. Our team speaks English, Spanish and Mandarin. Reach us 24/7 via WhatsApp, WeChat, Skype, email or phone.',
  },
  {
    icon: 'M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11',
    title: 'Real-Time Tracking',
    text:
      'Track every shipment on our cloud logistics dashboard. Ocean: container BL number, vessel AIS position, ETA port and ETA door. Air: master AWB, flight departure and arrival status. DDP: truck and courier tracking linked to UPS, FedEx, DHL and GLS. Automatic email and WeChat alerts at every milestone.',
  },
  {
    icon: 'M20 8l-8-4-8 4v8l8 4 8-4V8zM12 12L4 8m8 4l8-4m-8 4v8',
    title: 'One-Stop Service',
    text:
      'From factory door to consignee door, one team handles everything. China inland trucking from any supplier. Export customs clearance and certificates of origin. Bonded warehousing with free 30-day storage. Sea, air or rail main carriage. Destination import clearance with duties and VAT pre-paid. Amazon FBA prep, insurance and final-mile delivery.',
  },
  {
    icon: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zm14 10v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
    title: 'Experienced Team',
    text:
      'Founded in 2008, we are NVOCC and Class-A licensed. Our 80+ certified specialists include licensed customs declarants, IATA-certified DG handlers, FBA experts, project cargo engineers and tariff analysts. Average team experience exceeds 9 years. We have handled 45,000+ shipments to 120+ countries.',
  },
  {
    icon: 'M12 2a10 10 0 100 20 10 10 0 000-20zM2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z',
    title: 'Global Network',
    text:
      'Our overseas offices and audited partners cover 60+ countries. USA: LA, NY, Chicago, Dallas, Seattle. Canada: Vancouver, Toronto. EU 27 via Hamburg, Rotterdam, Antwerp and Milan. UK: Tilbury, Heathrow. Australia: Sydney, Melbourne. Plus Japan, Korea, Mexico, Southeast Asia, Middle East, Turkey, India and Latin America.',
  },
];

/* 三条客户评价（需求文档板块 5）：头像 + 名字 + 职位 + SEO 长评价 */
const testimonials = [
  {
    name: 'David Morrison',
    title: 'Founder & CEO, Morrison Home Goods Inc., Los Angeles, USA',
    quote:
      'We have shipped 40HQ FCL containers from Shenzhen to Long Beach with Dantful Logistics for over 7 years. We enjoy consistent 18-day port-to-port Trans-Pacific transits and competitive all-in rates. They never missed a sailing, even during the 2021 peak season crunch. Their in-house US customs team handles ISF-10 and AMS filings perfectly. Their DDP door-to-door service saved us 22% on landed cost last year. Their Amazon FBA sea-express division delivered 150 CBM of kitchenware to LGB8, ONT8 and LAX9 five days ahead of our 2024 Prime Day launch. Highly recommended China freight forwarder for any US importer.',
  },
  {
    name: 'Sarah Berger',
    title: 'Head of Supply Chain, GreenTech Outdoor GmbH, Hamburg, Germany',
    quote:
      'As a German outdoor gear brand sourcing from Guangzhou and Yiwu, we use Dantful Logistics for 100% of our China-to-EU shipments. This includes ocean FCL, LCL consolidation and air express. Their Hamburg partner handles import customs clearance, EU EORI filings and ENS declarations flawlessly. They also secure FORM E ASEAN FTA zero-tariff certificates of origin. This saves our company around EUR 48,000 per year in import duties. Real-time vessel AIS tracking and automatic milestone email updates keep us informed. Their 24/7 WhatsApp support makes them the most reliable China-EU freight forwarder we have worked with in 11 years.',
  },
  {
    name: 'James Chen',
    title: 'Owner, Oceana Living Homeware Pty Ltd., Sydney, Australia',
    quote:
      'I run a six-figure Australian Shopify store selling ceramic dinnerware, bamboo kitchenware and home textiles from Fujian and Zhejiang. I needed a forwarder who could consolidate goods from 8 suppliers into one LCL shipment. They perform AQL Level II quality inspections before export and apply MADE IN CHINA labels. Dantful delivers door-to-door DDP to our Sydney warehouse with all duties, GST and AQIS fees pre-paid. For 4 years they have delivered 12 to 16 day transit from China factory to Sydney. They offer 30-day free bonded warehousing and free FNSKU labeling for Amazon Australia FBA. Zero customs delays or hidden charges. A true one-stop solution for Australian importers and Amazon sellers.',
  },
];
---

<BaseLayout
  title="China Freight Forwarder | Ocean & Air Shipping"
  description="Reliable freight forwarder from China to worldwide. Ocean freight, air freight, Amazon FBA, customs clearance and door-to-door DDP logistics. Get a quote in 24 hours."
>
  <!-- ===== 板块 1：BANNER 轮播 ===== -->
  <Banner />

  <!-- ===== 板块 2：OUR SERVICES（6 个，图上文下，可点击） ===== -->
  <section id="services">
    <div class="container">
      <h2 class="section-title" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">OUR SERVICES <a href="/services/" style="font-size:0.85rem;font-weight:700;color:var(--blue);text-decoration:none;">View All &rarr;</a></h2>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="card svc-card">
            <img src={`/images/service-${s.slug}.webp`} alt={`${s.title} service from China - freight forwarding logistics`} class="svc-img" loading="lazy" />
            <h3>{s.title}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 板块 3：OUR ADVANTAGES（6 个，图标 + 文字） ===== -->
  <section class="section-soft" id="advantages">
    <div class="container">
      <h2 class="section-title" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">OUR ADVANTAGES <a href="/about/" style="font-size:0.85rem;font-weight:700;color:var(--blue);text-decoration:none;">Learn More &rarr;</a></h2>
      <div class="grid grid-3">
        {advantages.map((a) => (
          <div class="card adv-card">
            <div class="card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={a.icon} /></svg>
            </div>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 板块 4：ABOUT US（左图右文） ===== -->
  <section id="about">
    <div class="container grid grid-2 about-grid">
      <img src="/images/about-company.webp" alt="Shenzhen Dantful International Logistics office and team - China freight forwarder established 2008" class="about-img" loading="lazy" />
      <div class="prose">
        <h2 class="section-title" style="text-align:left">ABOUT US</h2>
        <p>SHENZHEN DANTFUL INT'L LOGISTICS CO., LTD. was established in Shenzhen, China in 2008. We are an NVOCC-class China freight forwarder. We offer comprehensive international logistics and door-to-door shipping solutions. Our clients include commercial cargo shippers, Amazon FBA sellers and e-commerce merchants. We ship from China to the USA, Canada, EU, United Kingdom, Australia, Japan, Mexico and 120+ countries worldwide.</p>
        <p>We bring 16+ years of industry experience, 80+ in-house specialists and 58,000 sqm of bonded warehousing across Shenzhen, Shanghai and Guangzhou. Our overseas partner network covers 60+ destination countries. We deliver ocean freight (FCL & LCL), air freight, Amazon FBA shipping, licensed customs brokerage, warehousing and DDP door-to-door service. From general cargo to DG dangerous goods and project cargo. Contact us today for a customized all-in shipping quote within 2 hours.</p>
        <a href="/about/" class="btn btn-outline">Learn More</a>
      </div>
    </div>
  </section>

  <!-- ===== 板块 5：CLIENTS SAY（头像 + 名字 + 职位 + 评价） ===== -->
  <section class="section-soft" id="clients">
    <div class="container">
      <h2 class="section-title" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">CLIENTS SAY <a href="/case/" style="font-size:0.85rem;font-weight:700;color:var(--blue);text-decoration:none;">View All Cases &rarr;</a></h2>
      <div class="grid grid-3">
        {testimonials.map((t) => (
          <div class="card testi-card">
            <!-- TODO【待补充】：头像图片放 public/images/ 后，用 <img class="avatar" src="..." alt="Client name" /> 换掉下面占位 -->
            <div class="avatar-ph" aria-hidden="true"></div>
            <h3>{t.name}</h3>
            <p class="testi-role">{t.title}</p>
            <p class="quote">“{t.quote}”</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 板块 6：GET A QUOTE 表单 ===== -->
  <QuoteForm />
</BaseLayout>

<style>
  .svc-card { display: flex; flex-direction: column; color: inherit; text-decoration: none !important; padding: 0; overflow: hidden; }
  .svc-img { display: block; width: 100%; height: 170px; object-fit: cover; }
  @media (max-width: 480px) { .svc-img { height: 140px; } }
  .svc-card h3, .svc-card p { padding-inline: 22px; }
  .svc-card h3 { margin-top: 18px; }
  .svc-card p { margin-bottom: 22px; }
  .svc-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); transition: all 0.2s ease; }
  .about-img { display: block; width: 100%; height: 380px; object-fit: cover; border-radius: 12px; }
  @media (max-width: 768px) { .about-img { height: 300px; } }
  @media (max-width: 480px) { .about-img { height: 220px; } }

  .about-grid { align-items: center; gap: 48px; }

  .testi-card { text-align: center; }
  .avatar-ph {
    width: 76px; height: 76px; border-radius: 50%; margin: 0 auto 14px;
    background: repeating-linear-gradient(45deg, #eef3f9, #eef3f9 8px, #e6edf6 8px, #e6edf6 16px);
    border: 2px dashed #9db6d2;
  }
  .testi-card :global(.avatar) { width: 76px; height: 76px; border-radius: 50%; object-fit: cover; margin: 0 auto 14px; }
  .testi-role { font-size: 0.82rem; color: var(--blue); font-weight: 700; margin-bottom: 12px; }
  .quote { font-style: italic; }
</style>
