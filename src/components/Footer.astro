---
import { SITE } from '../consts';
import { services } from '../data/services';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h3>{SITE.name}</h3>
      <p class="muted">
        Dantful Logistics is a NVOCC-licensed China freight forwarder established in 2008, specializing in ocean freight FCL &amp; LCL, air freight, Amazon FBA shipping, licensed customs clearance, bonded warehousing and complete door-to-door DDP logistics solutions from any Chinese factory to 120+ countries worldwide.
      </p>
      <p class="muted">
        Our Shenzhen-based logistics team of 80+ dedicated specialists provides 24-hour quote response, real-time shipment tracking and transparent all-in rates to USA, Canada, EU 27, United Kingdom, Australia, Japan, Mexico, Southeast Asia and the Middle East.
      </p>
      <p class="muted">© {year} {SITE.name}. All rights reserved.</p>
    </div>

    <div>
      <h3>Quick Links</h3>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About Us</a></li>
        <li><a href="/case/">Case</a></li>
        <li><a href="/news/">News</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>

    <div>
      <h3>Services</h3>
      <ul class="footer-links">
        {services.map((s) => (
          <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3>Contact</h3>
      <ul class="footer-links">
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={`tel:${SITE.phone.replace(/[\s-]/g, '')}`}>{SITE.phone}</a></li>
        <li>{SITE.address}</li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: #cdd9e6; padding: 56px 0 40px; }
  .site-footer h3 { color: #fff; font-size: 1.02rem; margin-bottom: 16px; }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: 36px; }
  .muted { color: #9db2c7; font-size: 0.9rem; margin-bottom: 12px; line-height: 1.6; }
  .footer-links { list-style: none; }
  .footer-links li { margin-bottom: 10px; }
  .footer-links a { color: #cdd9e6; font-size: 0.93rem; }
  .footer-links a:hover { color: #fff; text-decoration: none; }
  .footer-addr { font-style: normal; font-size: 0.93rem; line-height: 1.55; color: #cdd9e6; }
  .addr-zh { color: #8a9fb5; font-size: 0.86rem; display: inline-block; margin-top: 4px; }
  @media (max-width: 820px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
