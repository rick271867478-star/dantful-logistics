---
/**
 * Banner 大图轮播（需求文档 板块 1）
 * - 两张图：海运 + 空运，5 秒自动切换，支持左右按钮和圆点手动切换
 * - 图中央：大标题 + 简介 + CONTACT 按钮（平滑滚动到页面底部的 #quote 表单）
 * 替换真实图片方法：删掉两个 slide 里的 <ImgPlaceholder />，换成
 *   <img src="/images/banner-ocean.webp" loading="eager" fetchpriority="high" alt="Ocean freight container ship" />
 */
---

<section class="banner" aria-label="Featured banner">
  <div class="banner-track">
    <div class="banner-slide active">
      <img src="/images/banner-ocean.webp" loading="eager" fetchpriority="high" alt="Ocean freight container ship at port - China sea freight forwarding service" class="banner-img" />
      <div class="banner-caption">
        <h2>Reliable Freight Forwarding from China to Worldwide</h2>
        <a href="#quote" class="btn btn-primary">CONTACT</a>
      </div>
    </div>
    <div class="banner-slide">
      <img src="/images/banner-air.webp" loading="eager" fetchpriority="high" alt="Cargo airplane flying in blue sky - China air freight shipping service" class="banner-img" />
      <div class="banner-caption">
        <h2>Fast Air Freight from China to Your Door</h2>
        <a href="#quote" class="btn btn-primary">CONTACT</a>
      </div>
    </div>
  </div>

  <button class="banner-arrow prev" aria-label="Previous slide">‹</button>
  <button class="banner-arrow next" aria-label="Next slide">›</button>
  <div class="banner-dots" role="tablist" aria-label="Banner navigation"></div>
</section>

<style>
  .banner { position: relative; overflow: hidden; }
  .banner-track { position: relative; }
  .banner-slide { position: relative; opacity: 0; visibility: hidden; transition: opacity 0.8s ease; position: absolute; inset: 0; }
  .banner-slide.active { opacity: 1; visibility: visible; position: relative; }
  .banner-img { display: block; width: 100%; height: 480px; object-fit: cover; }

  .banner-caption {
    position: absolute; inset: 0; z-index: 5;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; gap: 16px; padding: 24px;
    background: rgba(11, 42, 74, 0.45);
    color: #fff;
  }
  .banner-caption h2 { color: #fff; font-size: clamp(1.6rem, 4vw, 2.8rem); font-weight: 800; max-width: 860px; }
  .banner-caption p { color: #dbe7f2; font-size: 1.05rem; max-width: 620px; }

  .banner-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.85); border: none;
    font-size: 1.6rem; line-height: 1; color: var(--navy); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .banner-arrow:hover { background: #fff; }
  .banner-arrow.prev { left: 16px; }
  .banner-arrow.next { right: 16px; }

  .banner-dots {
    position: absolute; bottom: 14px; left: 0; right: 0; z-index: 10;
    display: flex; justify-content: center; gap: 10px;
  }
  .banner-dots button {
    width: 12px; height: 12px; border-radius: 50%; border: none;
    background: rgba(255, 255, 255, 0.5); cursor: pointer; padding: 0;
  }
  .banner-dots button.active { background: var(--orange); }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLDivElement>('.banner-slide'));
  const dotsWrap = document.querySelector<HTMLDivElement>('.banner-dots');
  let index = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  slides.forEach((_, i) => {
    const b = document.createElement('button');
    b.setAttribute('aria-label', `Go to slide ${i + 1}`);
    b.addEventListener('click', () => { go(i); restart(); });
    dotsWrap?.appendChild(b);
  });
  const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('button')) : [];

  function go(n: number) {
    index = (n + slides.length) % slides.length;
    slides.forEach((s, i) => s.classList.toggle('active', i === index));
    dots.forEach((d, i) => d.classList.toggle('active', i === index));
  }
  function restart() {
    if (timer) clearInterval(timer);
    timer = setInterval(() => go(index + 1), 5000);
  }
  document.querySelector('.banner-arrow.prev')?.addEventListener('click', () => { go(index - 1); restart(); });
  document.querySelector('.banner-arrow.next')?.addEventListener('click', () => { go(index + 1); restart(); });
  restart();
</script>
