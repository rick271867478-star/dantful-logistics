---
/**
 * 图片占位组件 —— 所有【待补充】图片位置都用它标出。
 * 替换方法：图片放进 public/images/ 后，用
 *   <img src="/images/xxx.jpg" alt="英文描述（含关键词）" />
 * 换掉整个占位组件即可。每张图记得写英文 alt。
 */
interface Props {
  label: string;
  h?: string;
}
const { label, h = '260px' } = Astro.props;
---
<div class="img-ph" style={`height:${h}`} role="img" aria-label={label}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2"/>
    <circle cx="9" cy="10" r="1.6"/>
    <path d="m5 17 4-4 3 3 3-3 4 4"/>
  </svg>
  <span>{label}</span>
</div>

<style>
  .img-ph {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    background: repeating-linear-gradient(45deg, #eef3f9, #eef3f9 12px, #e6edf6 12px, #e6edf6 24px);
    border: 2px dashed #9db6d2; border-radius: var(--radius);
    color: #4a6080; text-align: center; padding: 16px;
  }
  .img-ph svg { width: 40px; height: 40px; color: #7b95b5; }
  .img-ph span { font-size: 0.88rem; font-weight: 600; max-width: 460px; }
</style>
